// to_oslist is "linux" on purpose: the Mac client only enables its compat layer
// when it starts with @sSteamCmdForcePlatformType linux, and then matches tools
// against that platform. See docs/neutron.md.
"compatibilitytools"
{
  "compat_tools"
  {
    "neutron_proton"
    {
      "install_path" "."
      "display_name" "Neutron"
      "from_oslist"  "windows"
      "to_oslist"    "linux"
    }
    // Second name for the same tool: dev/steam-sync.js maps games to it and back to
    // neutron_proton after the platform switch, which clears "invalid platform"
    // without a moment with no tool (that deletes the installed files).
    "neutron_proton_remap"
    {
      "install_path" "."
      "display_name" "Neutron (remap)"
      "from_oslist"  "windows"
      "to_oslist"    "linux"
    }
  }
}
