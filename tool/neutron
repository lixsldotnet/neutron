#!/bin/bash
#
# neutron: Steam compat tool entry point for macOS (the counterpart of Proton's
# `proton` script). Steam calls it as `neutron <verb> <args...>` with the
# STEAM_COMPAT_* environment set.
#
# Verbs: run, waitforexitandrun, runinprefix, getcompatpath, getnativepath,
#        destroyprefix
#
# Settings, per game as NEUTRON_<NAME>=<value> words in the launch options (the
# Compatibility tab in the game's properties writes them, dev/steam-panel.js) or
# for all games in neutron.env next to this script (KEY=value lines). Mac Steam
# does not support "VAR=x %command%" launch options, so the words are taken out of
# the game's command line here and exported; they override neutron.env.
#
#   NEUTRON_HUD=1|2             Metal performance HUD (FPS, frame and GPU time);
#                               2 adds DXMT's per-frame statistics (costs CPU time)
#   NEUTRON_FPS_LOG=1           FPS and slowest frame per second in the game log
#   NEUTRON_RENDER_SCALE=<0.5..1>  Windows sees a display this much smaller and
#                               MetalFX scales the output back (default 0.85, 1 = off)
#   NEUTRON_METALFX=<factor>    MetalFX upscale factor, default 1 / NEUTRON_RENDER_SCALE
#   NEUTRON_FEX_TSO=fast|strict FEX memory ordering; strict is the full x86 order,
#                               much slower (default fast, per game APP_TSO_<appid>)
#   NEUTRON_NATIVE_FULLSCREEN=0 no macOS native fullscreen and Game Mode for
#                               borderless fullscreen windows (default 1)
#   NEUTRON_RAW_MOUSE=0         raw input (mouse look) from the accelerated macOS
#                               cursor deltas instead of the GCMouse device deltas
#   NEUTRON_PRECISE_TIMERS=0    Sleep() through select() again instead of a kqueue timer
#   NEUTRON_MSYNC=1             events, semaphores and mutexes in the game process (shared
#                               memory) instead of a wineserver round trip; off by default
#                               until tested with more games. NEUTRON_MSYNC_SPIN=<ns> sets
#                               the spin before a wait sleeps (default 2000)
#   NEUTRON_APP_NAME=<name>     name in the menu bar and Dock (default from Steam's
#                               app manifest)
#   NEUTRON_LOG=1               Wine debug output in the log (WINEDEBUG overrides it)
#   NEUTRON_SANDBOX=1           run Wine in a macOS sandbox (neutron.sb): no access to
#                               the home folder outside the game, its prefix and the
#                               Steam files it needs, no host programs, no CEF port.
#                               Best in neutron.env: Steam's getcompatpath calls do not
#                               carry the launch options
#   NEUTRON_SANDBOX_LOCALHOST=0 sandbox: no connections to localhost at all (default
#                               only Steam's CEF debug port is closed)
#   NEUTRON_SANDBOX_GAME_DIR=<dir>  game folder the sandbox opens (default
#                               STEAM_COMPAT_INSTALL_PATH, else steamapps/common/<game>
#                               or the exe's folder)
#
# Development and diagnostics:
#   NEUTRON_FILES=<dir>         runtime to use instead of ./files
#   NEUTRON_STEAMCLIENT_DYLIB=<path>  steamclient.dylib for lsteamclient (default:
#                               found in the Steam folder)
#   NEUTRON_HUD_NOTE=<text>     one extra line in the HUD's neutron block
#   NEUTRON_LAYER_FORMAT=keep|bgra8  Metal layer format for 10-bit backbuffers:
#                               RGB10A2 like DXMT upstream, or 8 bit (default BGR10A2)
#   NEUTRON_SANDBOX_EXTRA_EXEC=<path>  tests only: one more host program the sandbox
#                               lets Wine start (the tests' native probe)
#   NEUTRON_NATIVE_DRAWABLE=0   DXMT's own drawable size instead of the view's size
#                               in screen pixels
#   NEUTRON_BENCH_NOVSYNC=1     benchmarks only: DXMT draws the present pass offscreen
#                               and never presents (dev/bench/run.sh)
#
# Set here for Wine and DXMT, not settings: NEUTRON_HUD_INFO, NEUTRON_APP_BUNDLE,
# NEUTRON_NTDLL.
#
#
# No -e on purpose: failures are logged and handled here, Steam gets the game's exit code.
set -uo pipefail

TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$TOOL_DIR/neutron.env" ]; then
  set -a
  # shellcheck source=/dev/null
  . "$TOOL_DIR/neutron.env"
  set +a
fi

# Per-game settings from the launch options (they override neutron.env).
args=()
for arg in "$@"; do
  case "$arg" in
    NEUTRON_[A-Z0-9_]*=*) export "${arg?}" ;;
    *) args+=("$arg") ;;
  esac
done
set -- ${args[@]+"${args[@]}"}
FILES="${NEUTRON_FILES:-$TOOL_DIR/files}"
WINE="$FILES/bin/wine"
WINESERVER="$FILES/bin/wineserver"

# Mac Steam may only pass STEAM_COMPAT_APP_ID; steam.exe needs SteamGameId to
# set up the Steam environment for the game.
if [ -n "${STEAM_COMPAT_APP_ID:-}" ]; then
  export SteamAppId="${SteamAppId:-$STEAM_COMPAT_APP_ID}"
  export SteamGameId="${SteamGameId:-$STEAM_COMPAT_APP_ID}"
fi
APP_ID="${SteamAppId:-${SteamGameId:-0}}"
LOG_DIR="$HOME/Library/Logs/neutron"
LOG="$LOG_DIR/neutron-$APP_ID.log"
mkdir -p "$LOG_DIR"

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }
die() { log "error: $*"; exit 1; }

#-------------------------------------------------------------------------------
#  environment
#-------------------------------------------------------------------------------

[ -n "${STEAM_COMPAT_DATA_PATH:-}" ] || die "no STEAM_COMPAT_DATA_PATH"
[ -x "$WINE" ] || die "wine not found at $WINE"

# arm64 Wine with ARM64EC system DLLs, the game's x86_64 code runs in FEX.
[ -d "$FILES/lib/wine/aarch64-windows" ] || die "not a neutron runtime: $FILES"
# Same prefix layout as Proton: Mac Steam resolves Steam Cloud paths of Windows
# games (WinAppDataLocalLow and co.) to compatdata/<appid>/pfx/drive_c/users/steamuser.
export WINEPREFIX="$STEAM_COMPAT_DATA_PATH/pfx"
export USER=steamuser   # Wine names the Windows profile after $USER
# FEX memory ordering: fast by default (Unity game 58 to 98 FPS against strict),
# strict for games with threading races under fast (APP_TSO_<appid>, below).
APP_TSO_427410=strict   # Abiotic Factor: GameThread vs SlateLoadingThread deadlock
tso_var="APP_TSO_$APP_ID"
NEUTRON_FEX_TSO="${NEUTRON_FEX_TSO:-${!tso_var:-fast}}"
# Borderless fullscreen games go into macOS native fullscreen (direct scanout, Game Mode).
export NEUTRON_NATIVE_FULLSCREEN="${NEUTRON_NATIVE_FULLSCREEN:-1}"
# msync (Wine patch 0015) is decided when wineserver starts, which inherits this.
export NEUTRON_MSYNC="${NEUTRON_MSYNC:-0}"
# Wine dlopens FreeType and GnuTLS by soname: bundled copies first, then Homebrew.
export DYLD_FALLBACK_LIBRARY_PATH="$FILES/lib:/opt/homebrew/lib:/usr/local/lib:/usr/lib"
# Light upscaling: Wine reports the display at this scale, MetalFX brings it back.
NEUTRON_RENDER_SCALE="${NEUTRON_RENDER_SCALE:-0.85}"
if awk -v s="$NEUTRON_RENDER_SCALE" 'BEGIN { exit !(s >= 0.5 && s < 1) }'; then
  export NEUTRON_RENDER_SCALE
  NEUTRON_METALFX="${NEUTRON_METALFX:-$(awk -v s="$NEUTRON_RENDER_SCALE" 'BEGIN { printf "%.4f", 1 / s }')}"
else
  unset NEUTRON_RENDER_SCALE
fi
if [ "${NEUTRON_LOG:-0}" = "1" ]; then
  export WINEDEBUG="${WINEDEBUG:-err+all,warn+steamclient,trace+steamclient}"
else
  export WINEDEBUG="${WINEDEBUG:--all}"
fi

if [ "${NEUTRON_HUD:-0}" = "1" ] || [ "${NEUTRON_HUD:-0}" = "2" ]; then
  export MTL_HUD_ENABLED=1
  export MTL_HUD_SCALE="${MTL_HUD_SCALE:-0.12}"
fi

# DXMT shader cache and Metal PSO cache live in the compat data of the game, not
# in macOS's user cache dir (/var/folders), which the system may purge.
export DXMT_SHADER_CACHE_PATH="${DXMT_SHADER_CACHE_PATH:-$STEAM_COMPAT_DATA_PATH/dxmt-cache}"

if [ -n "${NEUTRON_METALFX:-}" ]; then
  export DXMT_METALFX_SPATIAL_SWAPCHAIN=1
  export DXMT_CONFIG="d3d11.metalSpatialUpscaleFactor = $NEUTRON_METALFX${DXMT_CONFIG:+; $DXMT_CONFIG}"
fi
if [ "${NEUTRON_FEX_TSO:-}" = "strict" ]; then
  export FEX_VECTORTSOENABLED=1 FEX_MEMCPYSETTSOENABLED=1 FEX_HALFBARRIERTSOENABLED=0
fi

# Game name for the macOS menu bar and Dock (instead of "Wine"), from Steam's app manifest.
if [ -z "${NEUTRON_APP_NAME:-}" ] && [ "$APP_ID" != 0 ]; then
  manifest="${STEAM_COMPAT_DATA_PATH%/compatdata/*}/appmanifest_$APP_ID.acf"
  NEUTRON_APP_NAME="$(sed -n 's/^[[:space:]]*"name"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$manifest" 2>/dev/null | head -1)"
fi
export NEUTRON_APP_NAME

# Shown by DXMT under its version line in the Metal HUD.
# One line per ';', the HUD right-aligns the last word of each line.
NEUTRON_HUD_INFO="neutron;Wine $("$WINE" --version 2>/dev/null | sed 's/^wine-//')"
NEUTRON_HUD_INFO="$NEUTRON_HUD_INFO;FEX TSO $NEUTRON_FEX_TSO"
[ -n "${NEUTRON_RENDER_SCALE:-}" ] &&
  NEUTRON_HUD_INFO="$NEUTRON_HUD_INFO;Render scale $(awk -v s="$NEUTRON_RENDER_SCALE" 'BEGIN { printf "%d%%", s * 100 + 0.5 }')"
[ -n "${NEUTRON_METALFX:-}" ] &&
  NEUTRON_HUD_INFO="$NEUTRON_HUD_INFO;MetalFX $(awk -v f="$NEUTRON_METALFX" 'BEGIN { printf "%.2fx", f }')"
# NEUTRON_HUD_NOTE adds one free line (dev/direct-test.sh names its variants with it).
[ -n "${NEUTRON_HUD_NOTE:-}" ] && NEUTRON_HUD_INFO="$NEUTRON_HUD_INFO;$NEUTRON_HUD_NOTE"
export NEUTRON_HUD_INFO

STEAM_ROOT="${STEAM_COMPAT_CLIENT_INSTALL_PATH:-$HOME/Library/Application Support/Steam}"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT"

# The Mac client keeps steamclient.dylib inside its app bundle; lsteamclient
# reads the exact file from NEUTRON_STEAMCLIENT_DYLIB.
find_steamclient() {
  local candidate
  for candidate in \
    "$STEAM_ROOT/Steam.AppBundle/Steam/Contents/MacOS/steamclient.dylib" \
    "$STEAM_ROOT/steamclient.dylib"; do
    if [ -f "$candidate" ]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

if [ -z "${NEUTRON_STEAMCLIENT_DYLIB:-}" ]; then
  NEUTRON_STEAMCLIENT_DYLIB="$(find_steamclient)" || die "steamclient.dylib not found under $STEAM_ROOT"
fi
export NEUTRON_STEAMCLIENT_DYLIB

#-------------------------------------------------------------------------------
#  sandbox
#-------------------------------------------------------------------------------

# With NEUTRON_SANDBOX=1 every Wine process of the prefix runs under sandbox-exec
# with neutron.sb (see there). All Wine starts go through run_wine: a wineserver
# started outside the sandbox would open files for the sandboxed game.
SANDBOX=()

# Absolute path with symlinks resolved (the sandbox checks real paths: /tmp is
# /private/tmp). The folder has to exist.
real_dir() { (cd "$1" 2>/dev/null && pwd -P); }

setup_sandbox() {
  [ "${NEUTRON_SANDBOX:-0}" = 1 ] || return 0
  local profile="$TOOL_DIR/neutron.sb" game="${NEUTRON_SANDBOX_GAME_DIR:-${STEAM_COMPAT_INSTALL_PATH:-}}"
  # Fail closed: a missing profile or sandbox-exec never means "run without".
  [ -f "$profile" ] || die "NEUTRON_SANDBOX=1 but no profile at $profile"
  [ -x /usr/bin/sandbox-exec ] || die "NEUTRON_SANDBOX=1 but no /usr/bin/sandbox-exec"
  # Without STEAM_COMPAT_INSTALL_PATH: the game's folder under steamapps/common
  # (the exe may sit deeper, Binaries/Win64), else the exe's own folder.
  if [ -z "$game" ] && [ -f "${1:-}" ]; then
    case "$1" in
      */steamapps/common/*/*)
        local rest="${1#*/steamapps/common/}"
        game="${1%%/steamapps/common/*}/steamapps/common/${rest%%/*}" ;;
      *) game="$(dirname "$1")" ;;
    esac
  fi
  [ -n "$game" ] && { game="$(real_dir "$game")" || game=""; }
  mkdir -p "$WINEPREFIX"
  local prefix dev ino
  prefix="$(real_dir "$WINEPREFIX")"
  # Wine's server dir: /tmp/.wine-<uid>/server-<dev>-<ino> of the prefix, in hex.
  read -r dev ino < <(stat -f '%d %i' "$prefix")
  local server_dir cef_port
  # Steam's CEF debug port: from the Steam start script's environment, else the
  # file it writes (install.sh), else Steam's default.
  cef_port="${STEAM_CEF_PORT:-$(cat "$HOME/Library/Application Support/neutron/run/cef-port" 2>/dev/null)}"
  case "$cef_port" in ''|*[!0-9]*) cef_port=8080 ;; esac
  server_dir="$(printf '/private/tmp/.wine-%u/server-%x-%x' "$(id -u)" "$dev" "$ino")"
  SANDBOX=(/usr/bin/sandbox-exec -f "$profile"
    -D HOME="$(real_dir "$HOME")"
    -D TOOL_DIR="$(real_dir "$TOOL_DIR")"
    -D FILES="$(real_dir "$FILES")"
    -D COMPAT="$(real_dir "$STEAM_COMPAT_DATA_PATH")"
    -D GAME="$game"
    -D STEAM_ROOT="$(real_dir "$STEAM_ROOT" || printf '%s' "$STEAM_ROOT")"
    -D APPID="$APP_ID"
    -D LOGS="$(real_dir "$LOG_DIR")"
    -D SERVER_DIR="$server_dir"
    -D CEF_PORT="$cef_port"
    -D LOCALHOST="$( [ "${NEUTRON_SANDBOX_LOCALHOST:-1}" = 0 ] && echo deny || echo allow )"
    -D EXTRA_EXEC="${NEUTRON_SANDBOX_EXTRA_EXEC:-}")
  log "sandbox on: game dir '${game:-none}', server $server_dir"
}

# sandbox-exec is a SIP binary, dyld drops DYLD_* for it and its children; env puts
# the library path back for Wine.
run_wine() {
  if [ ${#SANDBOX[@]} -gt 0 ]; then
    "${SANDBOX[@]}" /usr/bin/env DYLD_FALLBACK_LIBRARY_PATH="$DYLD_FALLBACK_LIBRARY_PATH" "$WINE" "$@"
  else
    "$WINE" "$@"
  fi
}

#-------------------------------------------------------------------------------
#  prefix
#-------------------------------------------------------------------------------

# Copies src to dst only when the content differs (keeps mtimes stable).
sync_file() {
  local src="$1" dst="$2"
  mkdir -p "$(dirname "$dst")"
  cmp -s "$src" "$dst" 2>/dev/null || cp "$src" "$dst"
}

setup_prefix() {
  if [ ! -f "$WINEPREFIX/system.reg" ]; then
    log "creating prefix $WINEPREFIX"
    mkdir -p "$WINEPREFIX"
    # No Mono/Gecko install prompts: they block on a dialog nobody sees.
    WINEDLLOVERRIDES="mscoree,mshtml=" run_wine wineboot -i >> "$LOG" 2>&1 \
      || die "wineboot failed"
    "$WINESERVER" -w
  fi

  # After a runtime update Wine would update the prefix on the next start and
  # show the Mono/Gecko prompt; do the update here, without the prompt.
  local stamp="$WINEPREFIX/neutron-runtime-stamp" now
  now="$(stat -f '%m %z' "$FILES/share/wine/wine.inf" 2>/dev/null)"
  if [ "$(cat "$stamp" 2>/dev/null)" != "$now" ]; then
    log "updating prefix for the new runtime"
    WINEDLLOVERRIDES="mscoree,mshtml=" run_wine wineboot -u >> "$LOG" 2>&1
    "$WINESERVER" -w
    printf '%s' "$now" > "$stamp"
  fi

  # Games load steamclient64.dll from the Steam folder; that is our bridge.
  local steam_dir="$WINEPREFIX/drive_c/Program Files (x86)/Steam"
  sync_file "$FILES/lib/wine/aarch64-windows/lsteamclient.dll" "$steam_dir/steamclient64.dll"

  setup_steam_registry
  setup_emulator_registry
  sandbox_user_dirs
}

# Wine links the prefix's Documents, Desktop, Downloads, Music, Pictures and Videos
# to the Mac home folders. The sandbox closes those, so games could not write their
# saves to My Documents: in sandbox mode they become real folders in the prefix, as
# in Proton (Steam Cloud uses steamuser/Documents and co. either way). Saves a game
# wrote through the links stay in ~/Documents (copy them over by hand if needed).
sandbox_user_dirs() {
  [ ${#SANDBOX[@]} -gt 0 ] || return 0
  local link target
  for link in "$WINEPREFIX/drive_c/users/$USER"/*; do
    [ -L "$link" ] || continue
    target="$(readlink "$link")"
    case "$target" in "$HOME"/*) ;; *) continue ;; esac
    rm "$link" && mkdir "$link" && log "sandbox: ${link##*/} is a folder in the prefix now, was a link to $target"
  done
}

# FEX translates the x86_64 game code (ARM64EC emulator DLL).
setup_emulator_registry() {
  local marker="$WINEPREFIX/neutron-fex-v1"
  [ -f "$marker" ] && return 0
  log "registering FEX as x64 emulator"
  run_wine reg add 'HKLM\Software\Microsoft\Wow64\amd64' /ve /d libarm64ecfex.dll /f >> "$LOG" 2>&1 \
    || die "emulator registry failed"
  "$WINESERVER" -w
  touch "$marker"
}

# steam_api finds steamclient64.dll through these keys. Proton ships them in
# its wine.inf ([SteamClient64]); upstream Wine does not, so import them once.
setup_steam_registry() {
  local marker="$WINEPREFIX/neutron-registry-v1"
  [ -f "$marker" ] && return 0

  local reg="$STEAM_COMPAT_DATA_PATH/neutron-steam.reg"
  local steam='C:\\Program Files (x86)\\Steam'
  cat > "$reg" <<EOF
Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\\Software\\Valve\\Steam]
"SteamPath"="$steam"
"SteamExe"="$steam\\\\Steam.exe"

[HKEY_CURRENT_USER\\Software\\Valve\\Steam\\ActiveProcess]
"PID"=dword:0000fffe
"SteamClientDll"="$steam\\\\steamclient.dll"
"SteamClientDll64"="$steam\\\\steamclient64.dll"
"SteamPath"="$steam"

[HKEY_LOCAL_MACHINE\\Software\\Valve\\Steam]
"InstallPath"="$steam"

[HKEY_LOCAL_MACHINE\\Software\\Wow6432Node\\Valve\\Steam]
"InstallPath"="$steam"
EOF
  log "importing Steam registry keys"
  run_wine reg import "$reg" >> "$LOG" 2>&1 || die "registry import failed"
  "$WINESERVER" -w
  rm -f "$reg"
  touch "$marker"
}

# Per-game fixes (like Proton's game fixes): extra arguments appended to the
# game's command line unless the launch options already contain them.
# Example: APP_ARGS_<appid>="-dx11"
# With -dx11 in APP_ARGS, a -dx12/-d3d12 from the game's launch entry is dropped
# (DXMT's D3D12 is not enough for these games yet).
APP_ARGS_1144200="-dx11"   # Ready or Not: "DirectX 12 is not supported" with -dx12

app_args() {
  local var="APP_ARGS_$APP_ID" arg
  for arg in ${!var:-}; do
    case " $* " in *" $arg "*) ;; *) printf '%s\n' "$arg" ;; esac
  done
}

# Per-game app bundle in the prefix folder: Windows processes start from it (Wine's
# NEUTRON_APP_BUNDLE), so the Dock, Cmd+Tab and window switchers show the game's
# name and the icon from its exe. The loader inside is a hard link to the runtime's.
setup_app_bundle() {
  local exe="$1" src="$FILES/lib/wine/aarch64-unix/Neutron.app" app="$STEAM_COMPAT_DATA_PATH/Neutron.app"
  local script_dir stamp tmp
  [ -x "$src/Contents/MacOS/wine" ] || return 0
  script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
  stamp="$(stat -f '%i %m' "$src/Contents/MacOS/wine") $APP_ID ${NEUTRON_APP_NAME:-}"
  if [ "$(cat "$app/neutron-stamp" 2>/dev/null)" != "$stamp" ]; then
    log "building the app bundle for $APP_ID"
    rm -rf "$app"
    mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
    ln "$src/Contents/MacOS/wine" "$app/Contents/MacOS/wine" 2>/dev/null \
      || cp "$src/Contents/MacOS/wine" "$app/Contents/MacOS/wine"
    cp "$src/Contents/Info.plist" "$app/Contents/Info.plist"
    plutil -replace CFBundleIdentifier -string "net.lixsl.neutron.app$APP_ID" "$app/Contents/Info.plist"
    [ -n "${NEUTRON_APP_NAME:-}" ] && plutil -replace CFBundleName -string "$NEUTRON_APP_NAME" "$app/Contents/Info.plist"
    tmp="$(mktemp -d)"
    if command -v python3 >/dev/null && [ -f "$exe" ] \
       && python3 -I "$script_dir/peicon.py" "$exe" "$tmp/icon.ico" \
       && sips -s format png "$tmp/icon.ico" --out "$tmp/icon.png" >/dev/null 2>&1 \
       && sips -z 256 256 "$tmp/icon.png" --out "$tmp/icon.png" >/dev/null 2>&1 \
       && sips -s format icns "$tmp/icon.png" --out "$app/Contents/Resources/AppIcon.icns" >/dev/null 2>&1; then
      plutil -replace CFBundleIconFile -string AppIcon "$app/Contents/Info.plist"
    fi
    rm -rf "$tmp"
    printf '%s' "$stamp" > "$app/neutron-stamp"
  fi
  export NEUTRON_APP_BUNDLE="$app" NEUTRON_NTDLL="$FILES/lib/wine/aarch64-unix/ntdll.so"
}

# Starts the game through Proton's steam.exe, which sets up the Steam registry
# keys and process state the game expects.
run_game() {
  setup_app_bundle "${1:-}"
  local extra=()
  while IFS= read -r arg; do [ -n "$arg" ] && extra+=("$arg"); done < <(app_args "$@")
  local var="APP_ARGS_$APP_ID" kept=() arg
  case " ${!var:-} " in
    *" -dx11 "*)
      for arg in "$@"; do case "$arg" in -dx12|-d3d12) ;; *) kept+=("$arg") ;; esac; done
      set -- ${kept[@]+"${kept[@]}"} ;;
  esac
  set -- "$@" ${extra[@]+"${extra[@]}"}
  log "run appid=$APP_ID args: $*"
  # In the background plus wait, so Steam's Stop (SIGTERM to this script) is handled
  # right away: end the whole Wine session of this prefix, the game included.
  trap 'log "stop requested"; "$WINESERVER" -k; exit 143' TERM INT HUP
  run_wine 'c:\windows\system32\steam.exe' "$@" >> "$LOG" 2>&1 &
  wait $!
  local rc=$?
  trap - TERM INT HUP
  log "exit $rc"
  return $rc
}

#-------------------------------------------------------------------------------
#  verbs
#-------------------------------------------------------------------------------

VERB="${1:-}"
[ $# -gt 0 ] && shift
log "verb=$VERB steamclient=$NEUTRON_STEAMCLIENT_DYLIB"

case "$VERB" in destroyprefix) ;; *) setup_sandbox "$@" ;; esac

case "$VERB" in
  run)
    setup_prefix
    # A wineserver started outside the sandbox (an earlier run without it, or a
    # Steam call without the setting) would open files for the sandboxed game:
    # wait until it is gone, like waitforexitandrun, so the game starts its own.
    [ ${#SANDBOX[@]} -gt 0 ] && "$WINESERVER" -w
    run_game "$@"
    ;;
  waitforexitandrun)
    setup_prefix
    "$WINESERVER" -w
    run_game "$@"
    ;;
  runinprefix)
    setup_prefix
    run_wine "$@"
    ;;
  getcompatpath)
    run_wine winepath -w "$1" 2>> "$LOG"
    ;;
  getnativepath)
    run_wine winepath "$1" 2>> "$LOG"
    ;;
  destroyprefix)
    log "destroying prefix $WINEPREFIX"
    "$WINESERVER" -k 2>/dev/null
    rm -rf "${WINEPREFIX:?}"
    ;;
  *)
    die "unknown verb '$VERB'"
    ;;
esac
