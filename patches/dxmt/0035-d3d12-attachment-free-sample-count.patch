Use a nonzero Metal sample count for attachment-free D3D12 pipelines whose
attachment sample count is zero. Match the command list render-pass default,
including ForcedSampleCount, without changing pipelines with color/depth targets.

diff --git a/src/d3d12/d3d12_pipeline_graphics.cpp b/src/d3d12/d3d12_pipeline_graphics.cpp
index b5a9f80..c97c917 100644
--- a/src/d3d12/d3d12_pipeline_graphics.cpp
+++ b/src/d3d12/d3d12_pipeline_graphics.cpp
@@ -363,6 +363,11 @@ public:
     }
 
     info.raster_sample_count = pDesc->SampleDesc.Count;
+    /* neutron: attachment-free D3D12 pipelines may arrive with no attachment
+       sample count. Match the command list's default raster sample count instead
+       of passing zero to Metal. Do not change sample counts with RTVs or a DSV. */
+    if (!info.raster_sample_count && !pDesc->NumRenderTargets && pDesc->DSVFormat == DXGI_FORMAT_UNKNOWN)
+      info.raster_sample_count = std::max(1u, pDesc->RasterizerState.ForcedSampleCount);
     info.support_indirect_command_buffers = true;
 
     info.alpha_to_coverage_enabled = pDesc->BlendState.AlphaToCoverageEnable && !ref_ps.PixelShader.HasCoverageOutput;
