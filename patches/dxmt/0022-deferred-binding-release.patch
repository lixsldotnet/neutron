     return {allocation->buffer(), allocation->offset()};
   }
 
+  /* neutron: a replaced binding is not released right away but at the end of the chunk. The
+     application thread takes a reference for every bind while this thread dropped the old one, so
+     both threads wrote the same refcount for every bind and stalled on the cache line. Released in
+     one burst, the line moves once per chunk. */
+  void
+  deferRelease(Rc<Buffer> &binding) {
+    if (binding.ptr())
+      released_buffers_.push_back(std::move(binding));
+  }
+  void
+  deferRelease(Rc<Texture> &binding) {
+    if (binding.ptr())
+      released_textures_.push_back(std::move(binding));
+  }
+  void
+  deferRelease(Rc<Sampler> &binding) {
+    if (binding.ptr())
+      released_samplers_.push_back(std::move(binding));
+  }
+
+  void
+  releaseDeferred() {
+    released_buffers_.clear();
+    released_textures_.clear();
+    released_samplers_.clear();
+  }
+
