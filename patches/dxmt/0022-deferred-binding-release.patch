The app thread takes a reference for every SRV, sampler or buffer bind while the encoder dropped the old
binding at once, so both threads wrote the same refcount line. Released per chunk: SRV/sampler heavy bench +26% FPS.

diff --git a/src/dxmt/dxmt_command_queue.hpp b/src/dxmt/dxmt_command_queue.hpp
index 0f5e040..e8868d4 100644
--- a/src/dxmt/dxmt_command_queue.hpp
+++ b/src/dxmt/dxmt_command_queue.hpp
@@ -117,6 +117,7 @@ public:
     attached_cmdbuf = cmdbuf;
     auto t1 = clock::now();
     readback = enc.flushCommands(cmdbuf, chunk_id, chunk_event_id);
+    enc.releaseDeferred(); /* neutron: replaced bindings, see ArgumentEncodingContext::deferRelease */
     auto t2 = clock::now();
     statistics.encode_prepare_interval += (t1 - t0);
     statistics.encode_flush_interval += (t2 - t1);
diff --git a/src/dxmt/dxmt_context.hpp b/src/dxmt/dxmt_context.hpp
