+/* neutron: Metal must not load from or store to the null pointer that the bound
+   check selects for out-of-range indices and null descriptors. */
+llvm::Value *
+Converter::CreateBoundCheckedAccess(
+    llvm::Value *Ptr, bool Checked, llvm::Type *Ty, llvm::function_ref<llvm::Value *()> Access
+) {
+  if (!Checked)
+    return Access();
+  auto Fn = ir.GetInsertBlock()->getParent();
+  auto Before = ir.GetInsertBlock();
+  auto Then = llvm::BasicBlock::Create(ir.getContext(), "bound.ok", Fn);
+  auto Merge = llvm::BasicBlock::Create(ir.getContext(), "bound.end", Fn);
+  ir.CreateCondBr(ir.CreateIsNotNull(Ptr), Then, Merge);
+  ir.SetInsertPoint(Then);
+  auto Value = Access();
+  auto ThenEnd = ir.GetInsertBlock();
+  ir.CreateBr(Merge);
+  ir.SetInsertPoint(Merge);
+  if (!Ty)
+    return nullptr;
+  auto Phi = ir.CreatePHI(Ty, 2);
+  Phi->addIncoming(llvm::Constant::getNullValue(Ty), Before);
+  Phi->addIncoming(Value, ThenEnd);
+  return Phi;
+}
