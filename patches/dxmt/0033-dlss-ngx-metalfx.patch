+/* neutron: MetalFX temporal scalers for DLSS on D3D12 (DXMT's NGX core). Like the D3D11
+   context they are cached and never destroyed, a game creates only a few. */
+struct CachedTemporalScaler12 {
+  obj_handle_t device;
+  WMTFXTemporalScalerInfo info;
+  Rc<TemporalScaler> scaler;
+};
+
+static Rc<TemporalScaler>
+GetTemporalScaler12(WMT::Device device, const WMTFXTemporalScalerInfo &info) {
+  static std::mutex mutex;
+  static std::vector<CachedTemporalScaler12> cache;
+  std::lock_guard<std::mutex> lock(mutex);
+  for (auto &entry : cache) {
+    if (entry.device == device.handle && entry.info.color_format == info.color_format &&
+        entry.info.output_format == info.output_format && entry.info.depth_format == info.depth_format &&
+        entry.info.motion_format == info.motion_format && entry.info.input_width == info.input_width &&
+        entry.info.input_height == info.input_height && entry.info.output_width == info.output_width &&
+        entry.info.output_height == info.output_height && entry.info.auto_exposure == info.auto_exposure)
+      return entry.scaler;
+  }
+  Rc<TemporalScaler> scaler = new TemporalScaler(device, info);
+  if (!scaler->scaler())
+    return {};
+  cache.push_back({device.handle, info, scaler});
+  return scaler;
+}
+
+static WMTPixelFormat
+TemporalUpscaleMotionVectorFormat(WMTPixelFormat format) {
+  switch (format) {
+  case WMTPixelFormatRG16Uint:
+  case WMTPixelFormatRG16Float:
+  case WMTPixelFormatRG16Sint:
+  case WMTPixelFormatRG16Snorm:
+  case WMTPixelFormatRG16Unorm:
+    return WMTPixelFormatRG16Float;
+  case WMTPixelFormatRG32Uint:
+  case WMTPixelFormatRG32Float:
+  case WMTPixelFormatRG32Sint:
+    return WMTPixelFormatRG32Float;
+  case WMTPixelFormatRGBA16Sint:
+  case WMTPixelFormatRGBA16Snorm:
+  case WMTPixelFormatRGBA16Uint:
+  case WMTPixelFormatRGBA16Unorm:
+  case WMTPixelFormatRGBA16Float:
+    return WMTPixelFormatRGBA16Float;
+  default:
+    break;
+  }
+  return WMTPixelFormatInvalid;
+}
