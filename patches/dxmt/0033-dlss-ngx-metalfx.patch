+
+NVNGX_API NVNGX_RESULT
+NVSDK_NGX_D3D12_CreateFeature(
+    ID3D12GraphicsCommandList *command_list, unsigned int feature, NVNGXParameter *params, unsigned int **out_handle
+) {
+  auto parameters = static_cast<ParametersImpl *>(params);
+  Com<IMTLD3D12CommandListExt> pListExt = nullptr;
+  if (!command_list || FAILED(command_list->QueryInterface(IID_PPV_ARGS(&pListExt))))
+    return NVNGX_RESULT_INVALID_PARAMETER;
+  if (feature == NVNGX_FEATURE_SUPERSAMPLING) {
+    BOOL feature_supported = false;
+    if (FAILED(pListExt->CheckTemporalUpscaleSupport(&feature_supported)) || !feature_supported)
+      return NVNGX_RESULT_FEATURE_NOT_SUPPORTED;
+    return CreateDLSSFeature(parameters, out_handle);
+  }
+
+  ERR("NVSDK_NGX_D3D12_CreateFeature: feature ", feature, " not handled");
+  return NVNGX_RESULT_FAIL;
+}
+
+NVNGX_API NVNGX_RESULT
+NVSDK_NGX_D3D12_EvaluateFeature(
+    ID3D12GraphicsCommandList *command_list, const unsigned int *handle, NVNGXParameter *params, void *callback
+) {
+  auto parameters = static_cast<ParametersImpl *>(params);
+  if (!handle || !command_list)
+    return NVNGX_RESULT_INVALID_PARAMETER;
+  switch (static_cast<CommonFeature *>((void *)handle)->feature) {
+  case NVNGX_FEATURE_SUPERSAMPLING: {
+    auto dlss = static_cast<DLSSFeature *>((void *)handle);
+
+    Com<IMTLD3D12CommandListExt> pListExt = nullptr;
+    if (FAILED(command_list->QueryInterface(IID_PPV_ARGS(&pListExt))))
+      return NVNGX_RESULT_INVALID_PARAMETER;
+
+    ID3D12Resource *input, *output, *depth, *mv, *exposure = nullptr;
+    if (NVNGX_FAILED(parameters->Get(NVNGX_Parameter_Color, &input)) || !input)
+      return NVNGX_RESULT_INVALID_PARAMETER;
+    if (NVNGX_FAILED(parameters->Get(NVNGX_Parameter_Output, &output)) || !output)
+      return NVNGX_RESULT_INVALID_PARAMETER;
+    if (NVNGX_FAILED(parameters->Get(NVNGX_Parameter_Depth, &depth)) || !depth)
+      return NVNGX_RESULT_INVALID_PARAMETER;
+    if (NVNGX_FAILED(parameters->Get(NVNGX_Parameter_MotionVectors, &mv)) || !mv)
+      return NVNGX_RESULT_INVALID_PARAMETER;
+    parameters->Get(NVNGX_Parameter_ExposureTexture, &exposure);
+
+    auto color_desc = input->GetDesc();
+    auto output_desc = output->GetDesc();
+
+    MTL_TEMPORAL_UPSCALE_D3D12_DESC desc = {};
+    desc.Color = input;
+    desc.Output = output;
+    desc.Depth = depth;
+    desc.MotionVector = mv;
+    desc.ExposureTexture = exposure;
+    FillDLSSEvaluation(
+        parameters, dlss, (UINT)color_desc.Width, color_desc.Height, (UINT)output_desc.Width, output_desc.Height, desc
+    );
+
+    if (FAILED(pListExt->TemporalUpscale(&desc)))
+      return NVNGX_RESULT_FAIL;
+    return NVNGX_RESULT_OK;
+  }
+  default:
+    break;
+  }
+  return NVNGX_RESULT_FAIL;
+}
