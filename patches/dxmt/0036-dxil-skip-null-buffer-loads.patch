+  /* neutron: a null pointer from the bounds check is not a legal Metal load.
+   * Keep the memory operation inside the valid branch and return D3D's zero. */
+  llvm::Value *
+  bounded_buffer_load(llvm::CallInst *call, llvm::Value *ptr, bool coherent) {
+    auto before = call->getParent();
+    auto then = llvm::SplitBlockAndInsertIfThen(B.CreateIsNotNull(ptr), call, false);
+    B.SetInsertPoint(then);
+    auto value = coherent ? (llvm::Value *)air.CreateDeviceCoherentLoad(B.getInt32Ty(), ptr)
+                          : (llvm::Value *)B.CreateLoad(B.getInt32Ty(), ptr);
+    auto merge = call->getParent();
+    auto phi = llvm::PHINode::Create(B.getInt32Ty(), 2, "bounded.load", &merge->front());
+    phi->addIncoming(B.getInt32(0), before);
+    phi->addIncoming(value, then->getParent());
+    B.SetInsertPoint(call);
+    return phi;
+  }
