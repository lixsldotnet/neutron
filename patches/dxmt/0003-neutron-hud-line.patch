 #include "dxmt_hud_state.hpp"
 #include "Metal.hpp"
+#include "util_env.hpp"
 #include <string>
 
 namespace dxmt {
@@ -12,22 +13,44 @@ HUDState::initialize(const std::string &heading) {
   hud_.addLabel(str_dxmt_version, String::string("com.apple.hud-graph.default", WMTUTF8StringEncoding));
   hud_.updateLabel(str_dxmt_version, String::string(heading.c_str(), WMTUTF8StringEncoding));
   line_labels_.push_back(std::move(str_dxmt_version));
+
+  /* neutron: runtime info from the compat tool, per-frame statistics with NEUTRON_HUD=2 */
+  /* lines separated by ';', the HUD right-aligns the last word of each line */
+  std::string info = env::getEnvVar("NEUTRON_HUD_INFO");
+  size_t pos = 0;
+  while (pos < info.size()) {
+    size_t end = info.find(';', pos);
+    if (end == std::string::npos)
+      end = info.size();
+    std::string line = info.substr(pos, end - pos);
+    pos = end + 1;
+    if (line.empty())
+      continue;
+    auto str_info = MakeString(("com.github.3shain.dxmt-neutron" + std::to_string(line_labels_.size())).c_str(),
+                               WMTUTF8StringEncoding);
+    hud_.addLabel(str_info, line_labels_.back());
+    hud_.updateLabel(str_info, String::string(line.c_str(), WMTUTF8StringEncoding));
+    line_labels_.push_back(std::move(str_info));
+  }
+  base_lines_ = line_labels_.size();
+  detail_ = env::getEnvVar("NEUTRON_HUD") == "2";
+#ifdef DXMT_DEBUG
+  detail_ = true;
+#endif
 }
 
