+      *reinterpret_cast<DXMT_DRAW_INDEXED_ARGUMENTS *>(ptr) = {Count, InstanceCount, Start, BaseVertex, StartInstance};
+      args_offset = offset;
+    } else {
+      auto [ptr, offset] = allocator_->AllocateGPUHeap(sizeof(DXMT_DRAW_ARGUMENTS), 16);
+      *reinterpret_cast<DXMT_DRAW_ARGUMENTS *>(ptr) = {Count, InstanceCount, Start, StartInstance};
+      args_offset = offset;
+    }
+    EncodeSetBuffer(WMTRenderCommandSetObjectBuffer, args_offset, SM50_BINDING_INDEX_DRAW_ARGUMENTS);
