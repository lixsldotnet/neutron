+  WMT::RenderPipelineState
+  GetMeshPipeline(uint32_t IndexFormat, bool Strip) override {
+    if (kind == Kind::Ordinary || IndexFormat > SM50_INDEX_BUFFER_FORMAT_UINT32)
+      return {};
+    if (kind == Kind::Tessellation)
+      Strip = false;
+    std::lock_guard<dxmt::mutex> lock(mesh_mutex_);
+    auto &state = mesh_pso_[IndexFormat][Strip];
+    if (state || mesh_pso_failed_[IndexFormat][Strip])
+      return state;
+    if (!mesh_func_[Strip])
+      mesh_func_[Strip] = CompileMeshFunction(Strip);
+    auto object_func = CompileObjectFunction(IndexFormat, Strip);
+    if (mesh_func_[Strip] && object_func) {
+      auto info = mesh_info_;
+      info.object_function = object_func.handle;
+      info.mesh_function = mesh_func_[Strip].handle;
+      info.fragment_function = ps_func_.handle;
+      WMT::Reference<WMT::Error> err;
+      {
+        /* D3D11 also serializes these (tessellation PSO creation) */
+        static dxmt::mutex global_mesh_pso_mutex;
+        std::lock_guard<dxmt::mutex> global_lock(global_mesh_pso_mutex);
+        state = device_->GetMTLDevice().newRenderPipelineState(info, err);
+      }
+      if (!state)
+        ERR("Failed to create mesh PSO: ", err.description().getUTF8String());
+    }
+    if (!state)
+      mesh_pso_failed_[IndexFormat][Strip] = true;
+    return state;
+  }
