+/* neutron: the drawable gets the view's size in screen pixels (winemac.drv puts it on
+   the layer) instead of backbuffer size times the MetalFX factor, and the present pass
+   scales the backbuffer into it. A drawable of another size than the view makes macOS
+   scale the layer in the compositor: on Retina screens (Windows sees points), with a
+   backbuffer smaller than the window, and with a render scale that does not divide
+   evenly. NEUTRON_NATIVE_DRAWABLE=0 keeps DXMT's own sizing. */
+bool
+Presenter::applyNativeSize() {
+  static const bool enabled = !getenv("NEUTRON_NATIVE_DRAWABLE") || strcmp(getenv("NEUTRON_NATIVE_DRAWABLE"), "0");
+  if (!enabled)
+    return false;
+  WMTLayerProps current;
+  layer_.getProps(current);
+  if (current.native_width < 1 || current.native_height < 1 || current.native_scale <= 0)
+    return false;
+  if (layer_props_.drawable_width == current.native_width && layer_props_.drawable_height == current.native_height &&
+      layer_props_.contents_scale == current.native_scale)
+    return false;
+  layer_props_.drawable_width = current.native_width;
+  layer_props_.drawable_height = current.native_height;
+  layer_props_.contents_scale = current.native_scale;
+  return true;
+}
