+      bool sm6 = GetReportedShaderModel() >= D3D_SHADER_MODEL_6_0;
+      out->WaveOps = sm6;
+      out->WaveLaneCountMin = sm6 ? 32 : 0;
+      out->WaveLaneCountMax = sm6 ? 32 : 0;
+      out->TotalLaneCount = sm6 ? 32 * 1024 : 0;
