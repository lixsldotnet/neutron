D3D12 CheckFeatureSupport: answer OPTIONS5/6/8/9/10/11/13/14/15/17/18, SERIALIZATION,
CROSS_NODE, DISPLAYABLE, EXISTING_HEAPS, PROTECTED_RESOURCE_SESSION_SUPPORT and
COMMAND_QUEUE_PRIORITY with "not supported" values and S_OK instead of E_NOTIMPL
(Unreal 5 asks OPTIONS9). SHADER_MODEL returns min(requested, supported) and fails for
unknown models; FEATURE_LEVELS only picks levels from the caller's list.
D3D12EnableExperimentalFeatures export (E_NOINTERFACE).

diff --git a/src/d3d12/d3d12.cpp b/src/d3d12/d3d12.cpp
index aacf63d..47f95cd 100644
--- a/src/d3d12/d3d12.cpp
+++ b/src/d3d12/d3d12.cpp
@@ -72,6 +72,16 @@ D3D12GetInterface(REFCLSID rcslid, REFIID iid, void **debug) {
   return E_NOINTERFACE;
 }
 
+/* neutron: Wine's and Windows' d3d12.dll export it; a game importing it
+   statically must still load. Experimental features need developer mode on
+   Windows, which answers E_NOINTERFACE without it. */
+extern "C" HRESULT WINAPI
+D3D12EnableExperimentalFeatures(UINT NumFeatures, const IID *pIIDs, void *pConfigurationStructs, UINT *pConfigurationStructSizes) {
+  for (UINT i = 0; i < NumFeatures && pIIDs; i++)
+    WARN("D3D12EnableExperimentalFeatures: ", dxmt::str::format(pIIDs[i]), " not supported");
+  return E_NOINTERFACE;
+}
+
 extern "C" HRESULT WINAPI
 D3D12GetDebugInterface(REFIID iid, void **debug) {
   WARN("D3D12GetDebugInterface: Unknown interface query ", dxmt::str::format(iid));
