+      /* simd_shuffle: the lane may differ per thread */
+      result = simd_typed("air.simd_shuffle", arg(1), false, {B.CreateTrunc(arg(2), B.getInt16Ty())});
+      return result ? llvm::Error::success() : unsupported("wave op type");
+    case op::WaveActiveAllEqual: {
+      auto first = simd_typed("air.simd_broadcast_first", arg(1), false, {});
+      if (!first)
+        return unsupported("wave op type");
+      auto eq = arg(1)->getType()->isFloatingPointTy() ? B.CreateFCmpOEQ(arg(1), first) : B.CreateICmpEQ(arg(1), first);
+      result = simd_call("air.simd_all", B.getInt1Ty(), {eq});
+      return llvm::Error::success();
+    }
+    case op::WaveActiveBit: {
+      static const char *names[] = {"air.simd_and", "air.simd_or", "air.simd_xor"};
+      auto kind = cint(2);
+      if (kind > 2)
+        return unsupported("wave bit op " + llvm::Twine(kind));
+      result = simd_typed(names[kind], arg(1), false, {});
+      return result ? llvm::Error::success() : unsupported("wave op type");
+    }
+    case op::WaveAllBitCount:
+    case op::WavePrefixBitCount: {
+      llvm::Value *bits = simd_call("air.simd_ballot.i64", B.getInt64Ty(), {arg(1)});
+      if (opc == op::WavePrefixBitCount) {
+        if (!lane)
+          return unsupported("wave prefix in this shader stage");
+        auto below = B.CreateSub(B.CreateShl(B.getInt64(1), B.CreateZExt(lane, B.getInt64Ty())), B.getInt64(1));
+        bits = B.CreateAnd(bits, below);
+      }
+      auto lo = B.CreateTrunc(bits, B.getInt32Ty());
+      auto hi = B.CreateTrunc(B.CreateLShr(bits, 32), B.getInt32Ty());
+      result = B.CreateAdd(
+          air.CreateIntUnOp(AIRBuilder::popcount, lo), air.CreateIntUnOp(AIRBuilder::popcount, hi)
+      );
+      return llvm::Error::success();
+    }
+    case op::QuadReadLaneAt:
+      result = simd_typed("air.quad_shuffle", arg(1), false, {B.CreateTrunc(arg(2), B.getInt16Ty())});
+      return result ? llvm::Error::success() : unsupported("quad op type");
+    case op::QuadOp: {
+      auto kind = cint(2); /* 0 across x, 1 across y, 2 diagonal */
+      if (kind > 2)
+        return unsupported("quad op " + llvm::Twine(kind));
+      result = simd_typed("air.quad_shuffle_xor", arg(1), false, {B.getInt16(kind + 1)});
+      return result ? llvm::Error::success() : unsupported("quad op type");
+    }
+    case op::WaveActiveOp:
+    case op::WavePrefixOp: {
+      auto kind = cint(2);
+      bool is_signed = cint(3) == 0;
+      static const char *active[] = {"air.simd_sum", "air.simd_product", "air.simd_min", "air.simd_max"};
+      static const char *prefix[] = {"air.simd_prefix_exclusive_sum", "air.simd_prefix_exclusive_product"};
+      if (opc == op::WaveActiveOp ? kind > 3 : kind > 1)
+        return unsupported("wave op kind " + llvm::Twine(kind));
+      result = simd_typed(opc == op::WaveActiveOp ? active[kind] : prefix[kind], arg(1), is_signed, {});
+      return result ? llvm::Error::success() : unsupported("wave op type");
+    }
+
+    default:
+      return unsupported(
+          "operation " + llvm::Twine(opc) + " (" + call->getCalledFunction()->getName() + ") not implemented"
+      );
+    }
+  }
+
+private:
+  llvm::IRBuilder<> &B;
+  AIRBuilder &air;
+  Converter &conv;
+  BindingMap &binding;
+  const ResourceTable &table;
+  const ShaderInfo &info;
+
+  /* Metal has no derivatives in kernels: SM 6.6 compute derivatives come from the
+     2x2 quad (lanes 4k..4k+3, x = lane bit 0, y = lane bit 1) */
+  llvm::Value *
+  derivative(llvm::Value *v, bool y) {
+    if (ctx->shader_type != microsoft::D3D11_SB_COMPUTE_SHADER)
+      return air.CreateDerivative(v, y);
+    if (!lane)
+      return nullptr;
+    auto other = simd_typed("air.quad_shuffle_xor", v, false, {B.getInt16(y ? 2 : 1)});
+    if (!other)
+      return nullptr;
+    auto upper = B.CreateICmpNE(B.CreateAnd(lane, y ? 2 : 1), B.getInt32(0));
+    return B.CreateSelect(upper, B.CreateFSub(v, other), B.CreateFSub(other, v));
+  }
+
+  llvm::Value *
+  simd_call(const char *name, llvm::Type *ret, llvm::ArrayRef<llvm::Value *> args) {
+    auto &C = B.getContext();
+    auto attrs = llvm::AttributeList::get(
+        C, {{~0U, llvm::Attribute::get(C, llvm::Attribute::Convergent)},
+            {~0U, llvm::Attribute::get(C, llvm::Attribute::NoUnwind)},
+            {~0U, llvm::Attribute::get(C, llvm::Attribute::WillReturn)}}
+    );
+    llvm::SmallVector<llvm::Type *> tys;
+    for (auto a : args)
+      tys.push_back(a->getType());
+    auto fn = B.GetInsertBlock()->getModule()->getOrInsertFunction(
+        name, llvm::FunctionType::get(ret, tys, false), attrs
+    );
+    return B.CreateCall(fn, args);
+  }
+
+  llvm::Value *
+  simd_typed(const char *base, llvm::Value *v, bool is_signed, llvm::ArrayRef<llvm::Value *> extra) {
+    auto ty = v->getType();
+    std::string name = base;
+    if (ty->isFloatTy())
+      name += ".f32";
+    else if (ty->isHalfTy())
+      name += ".f16";
+    else if (ty->isIntegerTy(32))
+      name += is_signed ? ".s.i32" : ".u.i32";
+    else if (ty->isIntegerTy(1)) {
+      /* bool: go through uint */
+      auto r = simd_typed(base, B.CreateZExt(v, B.getInt32Ty()), false, extra);
+      return r ? B.CreateICmpNE(r, B.getInt32(0)) : nullptr;
+    } else
+      return nullptr;
+    llvm::SmallVector<llvm::Value *> args{v};
+    args.append(extra.begin(), extra.end());
+    return simd_call(name.c_str(), ty, args);
+  }
+
+  llvm::Expected<HandleInfo>
+  handle(llvm::Value *v) {
+    auto h = resolve_handle(v, table);
+    if (!h)
+      return unsupported("resource handle not resolvable (dynamic handle selection not supported yet)");
+    if (h->heap && h->props0 == 0 && h->cls != Sampler)
+      return unsupported("heap resource handle without annotateHandle");
+    return *h;
+  }
+
+  /* struct { v0, v1, v2, v3, status } from a <4 x i32> */
+  llvm::Value *
+  make_resret(llvm::Type *ret_ty, llvm::Value *vec_i32, unsigned n = 4) {
+    auto st = llvm::cast<llvm::StructType>(ret_ty);
+    llvm::Value *s = llvm::UndefValue::get(st);
+    for (unsigned i = 0; i < n && i < st->getNumElements(); i++) {
+      auto elem_ty = st->getElementType(i);
+      llvm::Value *e = B.CreateExtractElement(vec_i32, (uint64_t)i);
+      if (elem_ty->isFloatTy())
+        e = B.CreateBitCast(e, elem_ty);
+      else if (elem_ty != e->getType())
+        e = B.CreateTrunc(e, elem_ty);
+      s = B.CreateInsertValue(s, e, {i});
+    }
+    if (st->getNumElements() == 5)
+      s = B.CreateInsertValue(s, B.getInt32(1), {4}); /* status: fully mapped */
+    return s;
+  }
+
+  llvm::Value *
+  to_i32(llvm::Value *v) {
+    if (v->getType()->isFloatTy())
+      return B.CreateBitCast(v, B.getInt32Ty());
+    return v;
+  }
+
+  llvm::Error
+  cbuffer_load_legacy(llvm::CallInst *call, llvm::Value *&result) {
+    auto h = handle(call->getArgOperand(1));
+    if (!h)
+      return h.takeError();
+    llvm::Optional<ConstantBufferDescriptor> cb;
+    if (h->heap) {
+      auto entry = heap_entry(*h, false, air.getIntTy(4)->getPointerTo(2));
+      if (!entry)
+        return unsupported("descriptor heap not directly indexed by the root signature");
+      cb = ConstantBufferDescriptor{entry->first, entry->second};
+    } else {
+      cb = binding.GetConstantBuffer(air, h->range_id, h->index);
+    }
+    if (!cb)
+      return unsupported("constant buffer not bound by the root signature");
+    auto st = llvm::cast<llvm::StructType>(call->getType());
+    auto vec_ty = air.getIntTy(4);
+    auto ptr = B.CreatePointerCast(cb->Pointer, vec_ty->getPointerTo(2));
+    auto v = B.CreateLoad(vec_ty, B.CreateGEP(vec_ty, ptr, {call->getArgOperand(2)}));
+    if (st->getNumElements() == 2 && st->getElementType(0)->isIntegerTy(64)) {
+      /* CBufRet.i64: two 64-bit values from xy and zw */
+      llvm::Value *r = llvm::UndefValue::get(st);
+      for (unsigned i = 0; i < 2; i++)
+        r = B.CreateInsertValue(r, combine64(B.CreateExtractElement(v, (uint64_t)(2 * i)),
+                                             B.CreateExtractElement(v, (uint64_t)(2 * i + 1))), {i});
+      result = r;
+      return llvm::Error::success();
+    }
+    if (st->getNumElements() != 4 || st->getElementType(0)->getPrimitiveSizeInBits() != 32)
+      return unsupported("16-bit/double cbuffer loads not implemented");
+    result = make_resret(st, v);
+    return llvm::Error::success();
+  }
+
+  llvm::Value *
+  combine64(llvm::Value *lo, llvm::Value *hi) {
+    return B.CreateOr(B.CreateZExt(lo, B.getInt64Ty()), B.CreateShl(B.CreateZExt(hi, B.getInt64Ty()), 32));
+  }
+
+  /* descriptor heap entry {handle, metadata, ...} (32 bytes) of a heap handle */
+  llvm::Optional<std::pair<llvm::Value *, llvm::Value *>>
+  heap_entry(const HandleInfo &h, bool sampler_heap, llvm::Type *handle_ty) {
+    auto base = binding.GetDescriptorHeap(air, sampler_heap);
+    if (!base)
+      return {};
+    auto i64 = B.getInt64Ty();
+    auto entry_ty = llvm::StructType::get(B.getContext(), {handle_ty, i64, i64, i64});
+    auto ptr = B.CreatePointerCast(base, entry_ty->getPointerTo(2));
+    auto handle = B.CreateLoad(handle_ty, B.CreateGEP(entry_ty, ptr, {h.index, B.getInt32(0)}));
+    auto meta = B.CreateLoad(i64, B.CreateGEP(entry_ty, ptr, {h.index, B.getInt32(1)}));
+    return std::make_pair((llvm::Value *)handle, (llvm::Value *)meta);
+  }
+
+  /* DXIL resource kind of a handle */
+  uint32_t
+  resource_kind(const HandleInfo &h) {
+    if (h.heap)
+      return h.props0 & 0xff;
+    auto from = [](ResourceType t, uint32_t stride) -> uint32_t {
+      switch (t) {
+      case ResourceType::TextureBuffer:
+        return RK_TypedBuffer;
+      case ResourceType::NonApplicable:
+        return stride ? RK_StructuredBuffer : RK_RawBuffer;
+      default:
+        return RK_Texture2D; /* some texture */
+      }
+    };
+    if (h.cls == SRV && info.srvMap.count(h.range_id)) {
+      auto &r = info.srvMap.at(h.range_id);
+      return from(r.resource_type, r.structure_stride);
+    }
+    if (h.cls == UAV && info.uavMap.count(h.range_id)) {
+      auto &r = info.uavMap.at(h.range_id);
+      return from(r.resource_type, r.structure_stride);
+    }
+    return RK_Invalid;
+  }
+
+  bool
+  is_texture(const HandleInfo &h) {
+    auto k = resource_kind(h);
+    return k != RK_RawBuffer && k != RK_StructuredBuffer && k != RK_Invalid && k != RK_CBuffer && k != RK_Sampler;
+  }
+
+  llvm::Optional<SamplerDescriptor>
+  sampler_of(const HandleInfo &s) {
+    if (!s.heap)
+      return binding.GetSampler(air, s.range_id, s.index);
+    auto base = binding.GetDescriptorHeap(air, true);
+    if (!base)
+      return {};
+    auto smp_ty = air.getSamplerHandleType();
+    auto i64 = B.getInt64Ty();
+    auto entry_ty = llvm::StructType::get(B.getContext(), {smp_ty, smp_ty, i64, i64});
+    auto ptr = B.CreatePointerCast(base, entry_ty->getPointerTo(2));
+    auto load = [&](unsigned f, llvm::Type *ty) {
+      return (llvm::Value *)B.CreateLoad(ty, B.CreateGEP(entry_ty, ptr, {s.index, B.getInt32(f)}));
+    };
+    return SamplerDescriptor{load(0, smp_ty), load(1, smp_ty), load(2, i64)};
+  }
+
+  llvm::Expected<BufferResourceHandle>
+  buffer(const HandleInfo &h) {
+    if (h.heap) {
+      auto entry = heap_entry(h, false, B.getInt32Ty()->getPointerTo(1));
+      if (!entry)
+        return unsupported("descriptor heap not directly indexed by the root signature");
+      uint32_t stride = (h.props0 & 0xff) == RK_StructuredBuffer ? h.props1 : 0;
+      bool coherent = (h.props0 >> 14) & 1;
+      return BufferResourceHandle{entry->first, entry->second, stride, swizzle_identity, coherent};
+    }
+    llvm::Optional<BufferDescriptor> d;
+    if (h.cls == SRV)
+      d = binding.GetSRVBuffer(air, h.range_id, h.index);
+    else if (h.cls == UAV)
+      d = binding.GetUAVBuffer(air, h.range_id, h.index);
+    if (!d)
+      return unsupported("buffer not bound by the root signature");
+    return BufferResourceHandle{d->Pointer, d->Metadata, d->StructureStride, swizzle_identity, d->GlobalCoherent};
+  }
+
+  llvm::Expected<TextureResourceHandle>
+  texture(const HandleInfo &h, bool compared = false) {
+    if (h.heap) {
+      uint32_t kind = h.props0 & 0xff;
+      bool is_uav = (h.props0 >> 12) & 1;
+      auto type = resource_type(kind);
+      if (!type)
+        return type.takeError();
+      auto logical = air::to_air_resource_type(*type, compared);
+      auto lowered = air::lowering_texture_1d_to_2d(logical);
+      Texture t;
+      t.kind = lowered;
+      t.memory_access = is_uav ? Texture::MemoryAccess::acesss_readwrite : Texture::MemoryAccess::access_sample;
+      switch (h.props1 & 0xff) {
+      case CT_I32:
+      case CT_I16:
+        t.sample_type = Texture::sample_int;
+        break;
+      case CT_U32:
+      case CT_U16:
+        t.sample_type = Texture::sample_uint;
+        break;
+      default:
+        t.sample_type = Texture::sample_float;
+        break;
+      }
+      auto entry = heap_entry(h, false, air.getTextureHandleType(lowered));
+      if (!entry)
+        return unsupported("descriptor heap not directly indexed by the root signature");
+      return TextureResourceHandle{t, logical, entry->first, entry->second, swizzle_identity, false};
+    }
+    llvm::Optional<TextureDescirptor> d;
+    if (h.cls == SRV)
+      d = binding.GetSRVTexture(air, h.range_id, h.index);
+    else if (h.cls == UAV)
+      d = binding.GetUAVTexture(air, h.range_id, h.index);
+    if (!d)
+      return unsupported("texture not bound by the root signature");
+    Texture t;
+    t.kind = d->ResourceKind;
+    t.memory_access = d->MemoryAccess;
+    t.sample_type = d->SampleType;
+    return TextureResourceHandle{t, d->ResourceKindLogical, d->ResourceHandle, d->Metadata, swizzle_identity,
+                                 d->GlobalCoherent};
+  }
+
+  bool
+  is_typed_buffer(const HandleInfo &h) {
+    if (h.heap)
+      return (h.props0 & 0xff) == RK_TypedBuffer;
+    if (h.cls == SRV) {
+      auto it = info.srvMap.find(h.range_id);
+      return it != info.srvMap.end() && it->second.resource_type == ResourceType::TextureBuffer;
+    }
+    if (h.cls == UAV) {
+      auto it = info.uavMap.find(h.range_id);
+      return it != info.uavMap.end() && it->second.resource_type == ResourceType::TextureBuffer;
+    }
+    return false;
+  }
+
+  /* dword index of a raw / structured access */
+  llvm::Value *
+  dword_index(const BufferResourceHandle &buf, llvm::Value *index, llvm::Value *offset) {
+    if (buf.StructureStride) {
+      auto off = llvm::isa<llvm::UndefValue>(offset) ? (llvm::Value *)B.getInt32(0) : offset;
+      return B.CreateAdd(B.CreateMul(index, B.getInt32(buf.StructureStride >> 2)), B.CreateLShr(off, 2));
+    }
+    return B.CreateLShr(index, 2);
+  }
+
+  llvm::Error
+  buffer_load(llvm::CallInst *call, llvm::Value *&result) {
+    auto h = handle(call->getArgOperand(1));
+    if (!h)
+      return h.takeError();
+    auto st = llvm::cast<llvm::StructType>(call->getType());
+    bool is64 = st->getElementType(0)->isIntegerTy(64);
+    if (!is64 && st->getElementType(0)->getPrimitiveSizeInBits() != 32)
+      return unsupported("16-bit/double buffer loads not implemented");
+    if (is64 && is_typed_buffer(*h))
+      return unsupported("64-bit typed buffer loads not implemented");
+    if (is_typed_buffer(*h)) {
+      auto tex = texture(*h);
+      if (!tex)
+        return tex.takeError();
+      auto addr = B.CreateAdd(call->getArgOperand(2), conv.DecodeTextureBufferOffset(tex->Metadata));
+      auto [v, _] = air.CreateRead(tex->Texture, tex->Handle, addr, nullptr, nullptr, B.getInt32(0), tex->GlobalCoherent);
+      if (v->getType() != air.getIntTy(4))
+        v = B.CreateBitCast(v, air.getIntTy(4));
+      result = make_resret(st, v);
+      return llvm::Error::success();
+    }
+    auto buf = buffer(*h);
+    if (!buf)
+      return buf.takeError();
+    auto base = dword_index(*buf, call->getArgOperand(2), call->getArgOperand(3));
+    llvm::Value *v = llvm::UndefValue::get(air.getIntTy(4));
+    unsigned mask = call->getFunction() && call->arg_size() > 4 && llvm::isa<llvm::ConstantInt>(call->getArgOperand(4))
+                        ? (unsigned)llvm::cast<llvm::ConstantInt>(call->getArgOperand(4))->getZExtValue()
+                        : 0xf;
+    if (dx_opcode(call) == op::BufferLoad)
+      mask = 0xf;
+    if (is64) {
+      llvm::Value *r = llvm::UndefValue::get(st);
+      for (unsigned i = 0; i < 4; i++) {
+        if (!(mask & (1u << i)))
+          continue;
+        llvm::Value *dw[2];
+        for (unsigned k = 0; k < 2; k++) {
+          auto ptr = conv.CreateGEPInt32WithBoundCheck(*buf, B.CreateAdd(base, B.getInt32(2 * i + k)));
+          dw[k] = buf->GlobalCoherent ? (llvm::Value *)air.CreateDeviceCoherentLoad(B.getInt32Ty(), ptr)
+                                      : (llvm::Value *)B.CreateLoad(B.getInt32Ty(), ptr);
+        }
+        r = B.CreateInsertValue(r, combine64(dw[0], dw[1]), {i});
+      }
+      result = B.CreateInsertValue(r, B.getInt32(1), {4});
+      return llvm::Error::success();
+    }
+    for (unsigned i = 0; i < 4; i++) {
+      if (!(mask & (1u << i)))
+        continue;
+      auto ptr = conv.CreateGEPInt32WithBoundCheck(*buf, B.CreateAdd(base, B.getInt32(i)));
+      auto e = buf->GlobalCoherent ? (llvm::Value *)air.CreateDeviceCoherentLoad(B.getInt32Ty(), ptr)
+                                   : (llvm::Value *)B.CreateLoad(B.getInt32Ty(), ptr);
+      v = B.CreateInsertElement(v, e, (uint64_t)i);
+    }
+    result = make_resret(st, v);
+    return llvm::Error::success();
+  }
+
+  llvm::Error
+  buffer_store(llvm::CallInst *call) {
+    auto h = handle(call->getArgOperand(1));
+    if (!h)
+      return h.takeError();
+    auto mask = (unsigned)llvm::cast<llvm::ConstantInt>(call->getArgOperand(8))->getZExtValue();
+    bool is64 = call->getArgOperand(4)->getType()->isIntegerTy(64);
+    if (!is64 && call->getArgOperand(4)->getType()->getPrimitiveSizeInBits() != 32)
+      return unsupported("16-bit/double buffer stores not implemented");
+    if (is64) {
+      if (is_typed_buffer(*h))
+        return unsupported("64-bit typed buffer stores not implemented");
+      auto buf = buffer(*h);
+      if (!buf)
+        return buf.takeError();
+      auto base = dword_index(*buf, call->getArgOperand(2), call->getArgOperand(3));
+      for (unsigned i = 0; i < 4; i++) {
+        if (!(mask & (1u << i)))
+          continue;
+        auto v = call->getArgOperand(4 + i);
+        llvm::Value *dw[2] = {B.CreateTrunc(v, B.getInt32Ty()), B.CreateTrunc(B.CreateLShr(v, 32), B.getInt32Ty())};
+        for (unsigned k = 0; k < 2; k++) {
+          auto ptr = conv.CreateGEPInt32WithBoundCheck(*buf, B.CreateAdd(base, B.getInt32(2 * i + k)));
+          if (buf->GlobalCoherent)
+            air.CreateDeviceCoherentStore(dw[k], ptr);
+          else
+            B.CreateStore(dw[k], ptr);
+        }
+      }
+      return llvm::Error::success();
+    }
+    if (is_typed_buffer(*h)) {
+      auto tex = texture(*h);
+      if (!tex)
+        return tex.takeError();
+      auto addr = B.CreateAdd(call->getArgOperand(2), conv.DecodeTextureBufferOffset(tex->Metadata));
+      llvm::Value *v = llvm::UndefValue::get(air.getTexelType(tex->Texture));
+      for (unsigned i = 0; i < 4; i++) {
+        llvm::Value *e = call->getArgOperand(4 + i);
+        if (llvm::isa<llvm::UndefValue>(e))
+          e = llvm::Constant::getNullValue(e->getType());
+        v = B.CreateInsertElement(v, e, (uint64_t)i);
+      }
+      air.CreateWrite(tex->Texture, tex->Handle, addr, nullptr, nullptr, B.getInt32(0), v, tex->GlobalCoherent);
+      return llvm::Error::success();
+    }
+    auto buf = buffer(*h);
+    if (!buf)
+      return buf.takeError();
+    auto base = dword_index(*buf, call->getArgOperand(2), call->getArgOperand(3));
+    for (unsigned i = 0; i < 4; i++) {
+      if (!(mask & (1u << i)))
+        continue;
+      auto ptr = conv.CreateGEPInt32WithBoundCheck(*buf, B.CreateAdd(base, B.getInt32(i)));
+      auto val = to_i32(call->getArgOperand(4 + i));
+      if (buf->GlobalCoherent)
+        air.CreateDeviceCoherentStore(val, ptr);
+      else
+        B.CreateStore(val, ptr);
+    }
+    return llvm::Error::success();
+  }
+
+  /* coordinates for a texture access; Count = how many of c0..c2 the kind uses */
+  std::pair<llvm::Value *, llvm::Value *>
+  coords(
+      const TextureResourceHandle &tex, llvm::Value *c0, llvm::Value *c1, llvm::Value *c2, bool is_float,
+      llvm::Value *c3 = nullptr
+  ) {
+    auto elem = is_float ? B.getFloatTy() : B.getInt32Ty();
+    auto vec = [&](llvm::ArrayRef<llvm::Value *> cs) -> llvm::Value * {
+      if (cs.size() == 1)
+        return cs[0];
+      llvm::Value *v = llvm::UndefValue::get(llvm::FixedVectorType::get(elem, cs.size()));
+      for (unsigned i = 0; i < cs.size(); i++)
+        v = B.CreateInsertElement(v, cs[i], (uint64_t)i);
+      return v;
+    };
+    auto zero = is_float ? (llvm::Value *)llvm::ConstantFP::get(elem, 0.0) : (llvm::Value *)B.getInt32(0);
+    llvm::Value *array = nullptr;
+    auto to_index = [&](llvm::Value *c) -> llvm::Value * {
+      if (!is_float)
+        return c;
+      return conv.ClampArrayIndex(c, tex.Metadata);
+    };
+    switch (tex.Logical) {
+    case Texture::texture1d:
+      return {vec({c0, zero}), nullptr};
+    case Texture::texture1d_array:
+      array = to_index(c1);
+      return {vec({c0, zero}), array};
+    case Texture::texture2d:
+    case Texture::texture2d_ms:
+    case Texture::depth2d:
+      return {vec({c0, c1}), nullptr};
+    case Texture::texture2d_array:
+    case Texture::texture2d_ms_array:
+    case Texture::depth2d_array:
+      return {vec({c0, c1}), to_index(c2)};
+    case Texture::texture3d:
+    case Texture::texturecube:
+    case Texture::depthcube:
+      return {vec({c0, c1, c2}), nullptr};
+    case Texture::texturecube_array:
+    case Texture::depthcube_array:
+      if (!c3)
+        return {nullptr, nullptr};
+      return {vec({c0, c1, c2}), to_index(c3)};
+    default:
+      return {nullptr, nullptr};
+    }
+  }
+
+  /* loadInput(sig id, row, col, vertex): the signature handlers keep inputs in a vec4 register file */
+  llvm::Error
+  load_input(llvm::CallInst *call, llvm::Value *&result) {
+    auto id = (uint32_t)llvm::cast<llvm::ConstantInt>(call->getArgOperand(1))->getZExtValue();
+    const SigElement *e = nullptr;
+    for (auto &x : *inputs)
+      if (x.id == id)
+        e = &x;
+    if (!e)
+      return unsupported("loadInput: unknown signature element");
+    auto ty = call->getType();
+    llvm::Value *v;
+    if (e->start_row < 0) {
+      if (e->kind == sk::Coverage && ctx->resource.coverage_mask_arg)
+        v = ctx->resource.coverage_mask_arg;
+      else
+        return unsupported("loadInput of semantic kind " + llvm::Twine(e->kind));
+    } else {
+      auto reg = B.CreateAdd(B.getInt32(e->start_row), call->getArgOperand(2));
+      auto col = B.CreateAdd(B.getInt32(e->start_col), B.CreateZExt(call->getArgOperand(3), B.getInt32Ty()));
+      auto file_ty = ctx->resource.input.ptr_int4->getType()->getNonOpaquePointerElementType();
+      auto ptr = B.CreateGEP(file_ty, ctx->resource.input.ptr_int4, {B.getInt32(0), reg, col});
+      v = B.CreateLoad(B.getInt32Ty(), ptr);
+    }
+    if (ty->isFloatTy())
+      v = B.CreateBitCast(v, ty);
+    else if (ty->isIntegerTy(1))
+      v = B.CreateICmpNE(v, B.getInt32(0));
+    else if (ty->isHalfTy())
+      v = B.CreateFPTrunc(B.CreateBitCast(v, B.getFloatTy()), ty);
+    else if (ty->isIntegerTy(16))
+      v = B.CreateTrunc(v, ty);
+    else if (!ty->isIntegerTy(32))
+      return unsupported("loadInput type");
+    result = v;
+    return llvm::Error::success();
+  }
+
+  llvm::Error
+  store_output(llvm::CallInst *call) {
+    auto id = (uint32_t)llvm::cast<llvm::ConstantInt>(call->getArgOperand(1))->getZExtValue();
+    const SigElement *e = nullptr;
+    for (auto &x : *outputs)
+      if (x.id == id)
+        e = &x;
+    if (!e)
+      return unsupported("storeOutput: unknown signature element");
+    llvm::Value *v = call->getArgOperand(4);
+    auto ty = v->getType();
+    if (ty->isHalfTy())
+      v = B.CreateFPExt(v, B.getFloatTy());
+    else if (ty->isIntegerTy(1) || ty->isIntegerTy(16))
+      v = B.CreateZExt(v, B.getInt32Ty());
+    if (e->start_row < 0) {
+      llvm::Value *slot = nullptr;
+      switch (e->kind) {
+      case sk::Depth:
+      case sk::DepthLessEqual:
+      case sk::DepthGreaterEqual:
+        slot = ctx->resource.depth_output_reg;
+        break;
+      case sk::Coverage:
+        slot = ctx->resource.coverage_mask_reg;
+        break;
+      case sk::StencilRef:
+        slot = ctx->resource.stencil_ref_reg;
+        break;
+      }
+      if (!slot)
+        return unsupported("storeOutput of semantic kind " + llvm::Twine(e->kind));
+      auto slot_ty = slot->getType()->getNonOpaquePointerElementType();
+      if (v->getType() != slot_ty)
+        v = B.CreateBitCast(v, slot_ty);
+      B.CreateStore(v, slot);
+      return llvm::Error::success();
+    }
+    if (v->getType()->isFloatTy())
+      v = B.CreateBitCast(v, B.getInt32Ty());
+    auto reg = B.CreateAdd(B.getInt32(e->start_row), call->getArgOperand(2));
+    auto col = B.CreateAdd(B.getInt32(e->start_col), B.CreateZExt(call->getArgOperand(3), B.getInt32Ty()));
+    auto file_ty = ctx->resource.output.ptr_int4->getType()->getNonOpaquePointerElementType();
+    B.CreateStore(v, B.CreateGEP(file_ty, ctx->resource.output.ptr_int4, {B.getInt32(0), reg, col}));
+    return llvm::Error::success();
+  }
+
+  llvm::Error
+  sample(llvm::CallInst *call, uint32_t opc, llvm::Value *&result) {
+    auto h = handle(call->getArgOperand(1));
+    auto s = handle(call->getArgOperand(2));
+    if (!h)
+      return h.takeError();
+    if (!s)
+      return s.takeError();
+    auto tex = texture(*h, opc == op::SampleCmp || opc == op::SampleCmpLevelZero || opc == 224);
+    if (!tex)
+      return tex.takeError();
+    auto sampler = sampler_of(*s);
+    if (!sampler)
+      return unsupported("sampler not bound by the root signature");
+    bool cube = tex->Logical == Texture::texturecube || tex->Logical == Texture::texturecube_array ||
+                tex->Logical == Texture::depthcube || tex->Logical == Texture::depthcube_array;
+    auto smp = cube ? sampler->CubeSamplerHandle : sampler->SamplerHandle;
+    auto [coord, array] = coords(
+        *tex, call->getArgOperand(3), call->getArgOperand(4), call->getArgOperand(5), true, call->getArgOperand(6)
+    );
+    if (!coord)
+      return unsupported("sample on this texture kind");
+    int32_t offset[3] = {0, 0, 0};
+    for (unsigned i = 0; i < 3; i++)
+      if (auto c = llvm::dyn_cast<llvm::ConstantInt>(call->getArgOperand(7 + i)))
+        offset[i] = (int32_t)c->getSExtValue();
+    auto fval = [&](unsigned i) -> llvm::Value * {
+      auto v = call->getArgOperand(i);
+      return llvm::isa<llvm::UndefValue>(v) ? (llvm::Value *)air.getFloat(0) : v;
+    };
+    std::pair<llvm::Value *, llvm::Value *> r;
+    bool kernel = ctx->shader_type == microsoft::D3D11_SB_COMPUTE_SHADER;
+    if (kernel && (opc == op::Sample || opc == op::SampleBias)) {
+      /* implicit LOD in a kernel: gradients from the quad */
+      unsigned n = coord->getType()->isVectorTy() ? llvm::cast<llvm::FixedVectorType>(coord->getType())->getNumElements() : 1;
+      llvm::Value *gx = llvm::UndefValue::get(coord->getType()), *gy = llvm::UndefValue::get(coord->getType());
+      for (unsigned i = 0; i < n; i++) {
+        auto c = n == 1 ? coord : B.CreateExtractElement(coord, (uint64_t)i);
+        auto dx = derivative(c, false), dy = derivative(c, true);
+        if (!dx || !dy)
+          return unsupported("compute sample gradients");
+        gx = n == 1 ? dx : B.CreateInsertElement(gx, dx, (uint64_t)i);
+        gy = n == 1 ? dy : B.CreateInsertElement(gy, dy, (uint64_t)i);
+      }
+      r = air.CreateSampleGrad(tex->Texture, tex->Handle, smp, coord, array, gx, gy, fval(opc == op::Sample ? 10 : 11), offset);
+      opc = ~0u;
+    } else if (kernel && opc == op::SampleCmp) {
+      opc = op::SampleCmpLevelZero;
+    }
+    switch (opc) {
+    case ~0u:
+      break;
+    case op::Sample:
+      r = air.CreateSample(tex->Texture, tex->Handle, smp, coord, array, offset, llvm::air::sample_min_lod_clamp{fval(10)});
+      break;
+    case op::SampleBias:
+      r = air.CreateSample(
+          tex->Texture, tex->Handle, smp, coord, array, offset, llvm::air::sample_bias{fval(10)},
+          llvm::air::sample_min_lod_clamp{fval(11)}
+      );
+      break;
+    case op::SampleGrad: {
+      unsigned n = llvm::cast<llvm::FixedVectorType>(coord->getType())->getNumElements();
+      auto grad = [&](unsigned base) {
+        llvm::Value *v = llvm::UndefValue::get(air.getFloatTy(n));
+        for (unsigned i = 0; i < n; i++)
+          v = B.CreateInsertElement(v, fval(base + i), (uint64_t)i);
+        return v;
+      };
+      r = air.CreateSampleGrad(tex->Texture, tex->Handle, smp, coord, array, grad(10), grad(13), fval(16), offset);
+      break;
+    }
+    case op::SampleCmp:
+      r = air.CreateSampleCmp(
+          tex->Texture, tex->Handle, smp, coord, array, call->getArgOperand(10), offset,
+          llvm::air::sample_bias{air.getFloat(0)}, llvm::air::sample_min_lod_clamp{fval(11)}
+      );
+      break;
+    case 224:
+      r = air.CreateSampleCmp(
+          tex->Texture, tex->Handle, smp, coord, array, call->getArgOperand(10), offset,
+          llvm::air::sample_level{fval(11)}
+      );
+      break;
+    case op::SampleCmpLevelZero:
+      r = air.CreateSampleCmp(
+          tex->Texture, tex->Handle, smp, coord, array, call->getArgOperand(10), offset,
+          llvm::air::sample_level{air.getFloat(0)}
+      );
+      break;
+    }
+    llvm::Value *v = r.first;
+    if (v->getType()->isFloatTy()) {
+      /* comparison: one float */
+      llvm::Value *vec = llvm::UndefValue::get(air.getFloatTy(4));
+      for (unsigned i = 0; i < 4; i++)
+        vec = B.CreateInsertElement(vec, v, (uint64_t)i);
+      v = vec;
+    }
+    if (v->getType() != air.getIntTy(4))
+      v = B.CreateBitCast(v, air.getIntTy(4));
+    result = make_resret(call->getType(), v);
+    return llvm::Error::success();
+  }
+
+  /* address of a texture or typed buffer element for atomics */
+  std::pair<llvm::Value *, llvm::Value *>
+  atomic_texture_address(const TextureResourceHandle &tex, llvm::CallInst *call, unsigned first) {
+    if (tex.Logical == Texture::texture_buffer)
+      return {B.CreateAdd(call->getArgOperand(first), conv.DecodeTextureBufferOffset(tex.Metadata)), nullptr};
+    return coords(tex, call->getArgOperand(first), call->getArgOperand(first + 1), call->getArgOperand(first + 2), false);
+  }
+
+  llvm::Value *
+  splat4(llvm::Value *v) {
+    llvm::Value *vec = llvm::UndefValue::get(llvm::FixedVectorType::get(v->getType(), 4));
+    for (unsigned i = 0; i < 4; i++)
+      vec = B.CreateInsertElement(vec, v, (uint64_t)i);
+    return vec;
+  }
+
+  llvm::Error
+  texture_atomic(llvm::CallInst *call, llvm::Value *&result) {
+    auto h = handle(call->getArgOperand(1));
+    if (!h)
+      return h.takeError();
+    auto tex = texture(*h);
+    if (!tex)
+      return tex.takeError();
+    if (call->getType()->isIntegerTy(64))
+      return atomic64(call, *tex, result);
+    if (!call->getType()->isIntegerTy(32))
+      return unsupported("texture atomic type");
+    static const llvm::AtomicRMWInst::BinOp ops[] = {
+        llvm::AtomicRMWInst::Add, llvm::AtomicRMWInst::And,  llvm::AtomicRMWInst::Or,
+        llvm::AtomicRMWInst::Xor, llvm::AtomicRMWInst::Min,  llvm::AtomicRMWInst::Max,
+        llvm::AtomicRMWInst::UMin, llvm::AtomicRMWInst::UMax, llvm::AtomicRMWInst::Xchg,
+    };
+    auto kind = (uint32_t)llvm::cast<llvm::ConstantInt>(call->getArgOperand(2))->getZExtValue();
+    if (kind > 8)
+      return unsupported("atomic op " + llvm::Twine(kind));
+    auto [pos, array] = atomic_texture_address(*tex, call, 3);
+    if (!pos)
+      return unsupported("texture atomic on this texture kind");
+    auto v = air.CreateAtomicRMW(tex->Texture, tex->Handle, ops[kind], pos, splat4(call->getArgOperand(6)), array);
+    if (!v)
+      return unsupported("texture atomic lowering failed");
+    result = v->getType()->isVectorTy() ? B.CreateExtractElement(v, (uint64_t)0) : v;
+    return llvm::Error::success();
+  }
+
+  /* Metal has 64-bit atomics for unsigned min/max only, and they return nothing
+     (Nanite's InterlockedMax on R32G32_UINT, Apple8+ for textures) */
+  llvm::Optional<const char *>
+  atomic64_op(llvm::CallInst *call) {
+    auto kind = (uint32_t)llvm::cast<llvm::ConstantInt>(call->getArgOperand(2))->getZExtValue();
+    if (!call->use_empty())
+      return {};
+    if (kind == 6)
+      return "min";
+    if (kind == 7)
+      return "max";
+    return {};
+  }
+
+  llvm::Value *
+  call_void(const std::string &name, llvm::ArrayRef<llvm::Value *> args) {
+    auto &C = B.getContext();
+    auto attrs = llvm::AttributeList::get(
+        C, {{~0U, llvm::Attribute::get(C, llvm::Attribute::NoUnwind)},
+            {~0U, llvm::Attribute::get(C, llvm::Attribute::WillReturn)}}
+    );
+    llvm::SmallVector<llvm::Type *> tys;
+    for (auto a : args)
+      tys.push_back(a->getType());
+    auto fn = B.GetInsertBlock()->getModule()->getOrInsertFunction(
+        name, llvm::FunctionType::get(B.getVoidTy(), tys, false), attrs
+    );
+    return B.CreateCall(fn, args);
+  }
+
+  /* The calls below are what the Metal compiler emits for texture2d<ulong>::atomic_max
+     and atomic_max_explicit(device atomic_ulong *). The Metal backend only takes them
+     in AIR 2.9 modules (macOS 27); with DXMT's AIR 2.6/2.7 it crashes
+     (XPC_ERROR_CONNECTION_INTERRUPTED). EmitBody bumps the module version for them. */
+  static constexpr bool kAtomic64Works = true;
+
+  llvm::Error
+  atomic64(llvm::CallInst *call, const TextureResourceHandle &tex, llvm::Value *&result) {
+    if (!kAtomic64Works)
+      return unsupported("64-bit texture atomics not implemented yet");
+    auto opname = atomic64_op(call);
+    if (!opname)
+      return unsupported("64-bit texture atomics: only InterlockedMin/Max on uint64 without result");
+    if (tex.Logical != Texture::texture2d)
+      return unsupported("64-bit texture atomics on this texture kind");
+    llvm::Value *pos = llvm::UndefValue::get(air.getIntTy(2));
+    pos = B.CreateInsertElement(pos, call->getArgOperand(3), (uint64_t)0);
+    pos = B.CreateInsertElement(pos, call->getArgOperand(4), (uint64_t)1);
+    llvm::Value *val = llvm::UndefValue::get(llvm::FixedVectorType::get(B.getInt64Ty(), 4));
+    for (unsigned i = 0; i < 4; i++)
+      val = B.CreateInsertElement(val, call->getArgOperand(6), (uint64_t)i);
+    needs_air_2_9 = true;
+    call_void(
+        std::string("air.atomic_") + *opname + "_explicit_texture_2d.u.v4i64",
+        {tex.Handle, pos, llvm::ConstantAggregateZero::get(air.getIntTy(2)), val, B.getInt32(0), B.getInt32(3)}
+    );
+    result = llvm::UndefValue::get(call->getType());
+    return llvm::Error::success();
+  }
+
+  llvm::Error
+  atomic64_buffer(llvm::CallInst *call, const BufferResourceHandle &buf, llvm::Value *&result) {
+    if (!kAtomic64Works)
+      return unsupported("64-bit buffer atomics not implemented yet");
+    auto opname = atomic64_op(call);
+    if (!opname)
+      return unsupported("64-bit buffer atomics: only InterlockedMin/Max on uint64 without result");
+    auto idx = dword_index(buf, call->getArgOperand(3), call->getArgOperand(4));
+    auto ptr32 = B.CreateGEP(B.getInt32Ty(), buf.Pointer, {idx});
+    auto ptr = B.CreateBitCast(ptr32, B.getInt64Ty()->getPointerTo(1));
+    needs_air_2_9 = true;
+    call_void(
+        std::string("air.atomic.global.") + *opname + ".u.i64",
+        {ptr, call->getArgOperand(6), B.getInt32(0), B.getInt32(2), B.getInt32(0), B.getInt1(true)}
+    );
+    result = llvm::UndefValue::get(call->getType());
+    return llvm::Error::success();
+  }
+
+  /* atomicCompareExchange(handle, o0, o1, o2, compare, value) */
+  llvm::Error
+  atomic_cmpxchg(llvm::CallInst *call, llvm::Value *&result) {
+    auto h = handle(call->getArgOperand(1));
+    if (!h)
+      return h.takeError();
+    if (!call->getType()->isIntegerTy(32))
+      return unsupported("64-bit compare exchange not implemented");
+    if (is_texture(*h)) {
+      auto tex = texture(*h);
+      if (!tex)
+        return tex.takeError();
+      auto [pos, array] = atomic_texture_address(*tex, call, 2);
+      if (!pos)
+        return unsupported("texture compare exchange on this texture kind");
+      auto [v, _] = air.CreateAtomicCmpXchg(
+          tex->Texture, tex->Handle, pos, splat4(call->getArgOperand(5)), splat4(call->getArgOperand(6)), array
+      );
+      result = v->getType()->isVectorTy() ? B.CreateExtractElement(v, (uint64_t)0) : v;
+      return llvm::Error::success();
+    }
+    auto buf = buffer(*h);
+    if (!buf)
+      return buf.takeError();
+    auto idx = dword_index(*buf, call->getArgOperand(2), call->getArgOperand(3));
+    auto ptr = B.CreateGEP(B.getInt32Ty(), buf->Pointer, {idx});
+    auto r = B.CreateAtomicCmpXchg(
+        ptr, call->getArgOperand(5), call->getArgOperand(6), {}, llvm::AtomicOrdering::Monotonic,
+        llvm::AtomicOrdering::Monotonic
+    );
+    result = B.CreateExtractValue(r, 0);
+    return llvm::Error::success();
+  }
+
+  /* textureGather(srv, sampler, c0..c3, o0, o1, channel[, compare]) */
+  llvm::Error
+  gather(llvm::CallInst *call, uint32_t opc, llvm::Value *&result) {
+    auto h = handle(call->getArgOperand(1));
+    auto s = handle(call->getArgOperand(2));
+    if (!h)
+      return h.takeError();
+    if (!s)
+      return s.takeError();
+    auto tex = texture(*h, opc == op::TextureGatherCmp);
+    if (!tex)
+      return tex.takeError();
+    auto sampler = sampler_of(*s);
+    if (!sampler)
+      return unsupported("sampler not bound by the root signature");
+    bool cube = tex->Logical == Texture::texturecube || tex->Logical == Texture::texturecube_array ||
+                tex->Logical == Texture::depthcube || tex->Logical == Texture::depthcube_array;
+    auto smp = cube ? sampler->CubeSamplerHandle : sampler->SamplerHandle;
+    auto [coord, array] = coords(
+        *tex, call->getArgOperand(3), call->getArgOperand(4), call->getArgOperand(5), true, call->getArgOperand(6)
+    );
+    if (!coord)
+      return unsupported("gather on this texture kind");
+    int32_t offset[3] = {0, 0, 0};
+    for (unsigned i = 0; i < 2; i++)
+      if (auto c = llvm::dyn_cast<llvm::ConstantInt>(call->getArgOperand(7 + i)))
+        offset[i] = (int32_t)c->getSExtValue();
+    std::pair<llvm::Value *, llvm::Value *> r;
+    if (opc == op::TextureGather)
+      r = air.CreateGather(tex->Texture, tex->Handle, smp, coord, array, offset, call->getArgOperand(9));
+    else
+      r = air.CreateGatherCompare(tex->Texture, tex->Handle, smp, coord, array, call->getArgOperand(10), offset);
+    llvm::Value *v = r.first;
+    if (v->getType() != air.getIntTy(4))
+      v = B.CreateBitCast(v, air.getIntTy(4));
+    result = make_resret(call->getType(), v);
+    return llvm::Error::success();
+  }
+
+  llvm::Error
+  texture_load(llvm::CallInst *call, llvm::Value *&result) {
+    auto h = handle(call->getArgOperand(1));
+    if (!h)
+      return h.takeError();
+    auto tex = texture(*h);
+    if (!tex)
+      return tex.takeError();
+    /* textureLoad(handle, mip/sample, c0, c1, c2, o0, o1, o2): immediate offsets add to the coordinates */
+    llvm::Value *c[3];
+    for (unsigned i = 0; i < 3; i++) {
+      c[i] = call->getArgOperand(3 + i);
+      auto off = call->getArgOperand(6 + i);
+      if (!llvm::isa<llvm::UndefValue>(c[i]) && !llvm::isa<llvm::UndefValue>(off))
+        c[i] = B.CreateAdd(c[i], off);
+    }
+    bool is_array_slice_last = tex->Logical == Texture::texture1d_array || tex->Logical == Texture::texture2d_array ||
+                               tex->Logical == Texture::texture2d_ms_array;
+    if (is_array_slice_last) {
+      /* the slice takes no offset */
+      unsigned slice = tex->Logical == Texture::texture1d_array ? 1 : 2;
+      c[slice] = call->getArgOperand(3 + slice);
+    }
+    auto [pos, array] = coords(*tex, c[0], c[1], c[2], false);
+    if (!pos)
+      return unsupported("textureLoad on this texture kind");
+    llvm::Value *level = call->getArgOperand(2);
+    if (llvm::isa<llvm::UndefValue>(level))
+      level = B.getInt32(0);
+    llvm::Value *sample = nullptr;
+    if (tex->Logical == Texture::texture2d_ms || tex->Logical == Texture::texture2d_ms_array) {
+      sample = level;
+      level = nullptr;
+    }
+    if (h->cls == UAV && level)
+      level = B.getInt32(0);
+    auto [v, _] = air.CreateRead(tex->Texture, tex->Handle, pos, array, sample, level, tex->GlobalCoherent);
+    if (v->getType() != air.getIntTy(4))
+      v = B.CreateBitCast(v, air.getIntTy(4));
+    result = make_resret(call->getType(), v);
+    return llvm::Error::success();
+  }
+
+  llvm::Error
+  texture_store(llvm::CallInst *call) {
+    auto h = handle(call->getArgOperand(1));
+    if (!h)
+      return h.takeError();
+    auto tex = texture(*h);
+    if (!tex)
+      return tex.takeError();
+    auto [pos, array] = coords(*tex, call->getArgOperand(2), call->getArgOperand(3), call->getArgOperand(4), false);
+    if (!pos)
+      return unsupported("textureStore on this texture kind");
+    auto texel_ty = air.getTexelType(tex->Texture);
+    llvm::Value *v = llvm::UndefValue::get(texel_ty);
+    auto elem_ty = llvm::cast<llvm::FixedVectorType>(texel_ty)->getElementType();
+    for (unsigned i = 0; i < 4; i++) {
+      llvm::Value *e = call->getArgOperand(5 + i);
+      if (llvm::isa<llvm::UndefValue>(e))
+        e = llvm::Constant::getNullValue(elem_ty);
+      if (e->getType() != elem_ty)
+        e = B.CreateBitCast(e, elem_ty);
+      v = B.CreateInsertElement(v, e, (uint64_t)i);
+    }
+    air.CreateWrite(tex->Texture, tex->Handle, pos, array, nullptr, B.getInt32(0), v, tex->GlobalCoherent);
+    return llvm::Error::success();
+  }
+
+  llvm::Error
+  sample_level(llvm::CallInst *call, llvm::Value *&result) {
+    auto h = handle(call->getArgOperand(1));
+    auto s = handle(call->getArgOperand(2));
+    if (!h)
+      return h.takeError();
+    if (!s)
+      return s.takeError();
+    auto tex = texture(*h);
+    if (!tex)
+      return tex.takeError();
+    auto sampler = sampler_of(*s);
+    if (!sampler)
+      return unsupported("sampler not bound by the root signature");
+    bool cube = tex->Logical == Texture::texturecube || tex->Logical == Texture::texturecube_array ||
+                tex->Logical == Texture::depthcube || tex->Logical == Texture::depthcube_array;
+    auto [coord, array] = coords(
+        *tex, call->getArgOperand(3), call->getArgOperand(4), call->getArgOperand(5), true, call->getArgOperand(6)
+    );
+    if (!coord)
+      return unsupported("sampleLevel on this texture kind");
+    int32_t offset[3] = {0, 0, 0};
+    for (unsigned i = 0; i < 3; i++)
+      if (auto c = llvm::dyn_cast<llvm::ConstantInt>(call->getArgOperand(7 + i)))
+        offset[i] = (int32_t)c->getSExtValue();
+    auto [v, _] = air.CreateSample(
+        tex->Texture, tex->Handle, cube ? sampler->CubeSamplerHandle : sampler->SamplerHandle, coord, array, offset,
+        llvm::air::sample_level{call->getArgOperand(10)}
+    );
+    if (v->getType() != air.getIntTy(4))
+      v = B.CreateBitCast(v, air.getIntTy(4));
+    result = make_resret(call->getType(), v);
+    return llvm::Error::success();
+  }
+
+  llvm::Error
+  atomic_binop(llvm::CallInst *call, llvm::Value *&result) {
+    auto h = handle(call->getArgOperand(1));
+    if (!h)
+      return h.takeError();
+    if (is_texture(*h))
+      return texture_atomic(call, result);
+    auto buf = buffer(*h);
+    if (!buf)
+      return buf.takeError();
+    if (call->getType()->isIntegerTy(64))
+      return atomic64_buffer(call, *buf, result);
+    if (!call->getType()->isIntegerTy(32))
+      return unsupported("atomic type");
+    static const llvm::AtomicRMWInst::BinOp ops[] = {
+        llvm::AtomicRMWInst::Add, llvm::AtomicRMWInst::And,  llvm::AtomicRMWInst::Or,
+        llvm::AtomicRMWInst::Xor, llvm::AtomicRMWInst::Min,  llvm::AtomicRMWInst::Max,
+        llvm::AtomicRMWInst::UMin, llvm::AtomicRMWInst::UMax, llvm::AtomicRMWInst::Xchg,
+    };
+    auto kind = (uint32_t)llvm::cast<llvm::ConstantInt>(call->getArgOperand(2))->getZExtValue();
+    if (kind > 8)
+      return unsupported("atomic op " + llvm::Twine(kind));
+    auto idx = dword_index(*buf, call->getArgOperand(3), call->getArgOperand(4));
+    AtomicBufferResourceHandle abuf{buf->Pointer, buf->Metadata, buf->StructureStride, 1, buf->GlobalCoherent};
+    auto ptr = conv.CreateGEPInt32WithBoundCheck(abuf, idx);
+    result = air.CreateAtomicRMW(ops[kind], ptr, call->getArgOperand(6));
+    if (!result)
+      return unsupported("atomic op lowering failed");
+    return llvm::Error::success();
+  }
+
+  llvm::Error
+  update_counter(llvm::CallInst *call, llvm::Value *&result) {
+    auto h = handle(call->getArgOperand(1));
+    if (!h)
+      return h.takeError();
+    auto counter = binding.GetUAVCounter(air, h->range_id, h->index);
+    if (!counter)
+      return unsupported("UAV counter not bound");
+    auto inc = (int8_t)llvm::cast<llvm::ConstantInt>(call->getArgOperand(2))->getSExtValue();
+    if (inc > 0) {
+      result = air.CreateAtomicRMW(llvm::AtomicRMWInst::Add, counter->Pointer, B.getInt32(1));
+    } else {
+      auto old = air.CreateAtomicRMW(llvm::AtomicRMWInst::Sub, counter->Pointer, B.getInt32(1));
+      result = B.CreateSub(old, B.getInt32(1));
+    }
+    return llvm::Error::success();
+  }
+
+  llvm::Error
+  get_dimensions(llvm::CallInst *call, llvm::Value *&result) {
+    auto h = handle(call->getArgOperand(1));
+    if (!h)
+      return h.takeError();
+    auto st = call->getType();
+    llvm::Value *s = llvm::UndefValue::get(st);
+    if (is_typed_buffer(*h)) {
+      auto tex = texture(*h);
+      if (!tex)
+        return tex.takeError();
+      s = B.CreateInsertValue(s, conv.DecodeTextureBufferElement(tex->Metadata), {0});
+    } else {
+      bool is_buffer = !is_texture(*h);
+      if (!is_buffer) {
+        auto tex = texture(*h);
+        if (!tex)
+          return tex.takeError();
+        llvm::Value *level = call->getArgOperand(2);
+        if (llvm::isa<llvm::UndefValue>(level) || h->cls == UAV)
+          level = B.getInt32(0);
+        auto q = [&](Texture::Query what, llvm::Value *lvl) {
+          return air.CreateTextureQuery(tex->Texture, tex->Handle, what, lvl);
+        };
+        llvm::Value *x = B.getInt32(0), *y = B.getInt32(0), *z = B.getInt32(0), *mips = B.getInt32(1);
+        switch (tex->Logical) {
+        case Texture::texture1d:
+          x = q(Texture::width, level);
+          break;
+        case Texture::texture1d_array:
+          x = q(Texture::width, level);
+          y = q(Texture::array_length, B.getInt32(0));
+          break;
+        case Texture::depth2d:
+        case Texture::texture2d:
+        case Texture::texturecube:
+        case Texture::depthcube:
+        case Texture::depth_2d_ms:
+        case Texture::texture2d_ms:
+          x = q(Texture::width, level);
+          y = q(Texture::height, level);
+          break;
+        case Texture::depth2d_array:
+        case Texture::texture2d_array:
+        case Texture::texturecube_array:
+        case Texture::depthcube_array:
+        case Texture::depth_2d_ms_array:
+        case Texture::texture2d_ms_array:
+          x = q(Texture::width, level);
+          y = q(Texture::height, level);
+          z = q(Texture::array_length, B.getInt32(0));
+          break;
+        case Texture::texture3d:
+          x = q(Texture::width, level);
+          y = q(Texture::height, level);
+          z = q(Texture::depth, level);
+          break;
+        default:
+          return unsupported("GetDimensions on this texture kind");
+        }
+        bool ms = tex->Logical == Texture::texture2d_ms || tex->Logical == Texture::texture2d_ms_array ||
+                  tex->Logical == Texture::depth_2d_ms || tex->Logical == Texture::depth_2d_ms_array;
+        if (ms)
+          mips = q(Texture::num_samples, B.getInt32(0));
+        else if (h->cls == SRV)
+          mips = q(Texture::num_mip_levels, B.getInt32(0));
+        s = B.CreateInsertValue(s, x, {0});
+        s = B.CreateInsertValue(s, y, {1});
+        s = B.CreateInsertValue(s, z, {2});
+        s = B.CreateInsertValue(s, mips, {3});
+        result = s;
+        return llvm::Error::success();
+      }
+      auto buf = buffer(*h);
+      if (!buf)
+        return buf.takeError();
+      llvm::Value *len = conv.DecodeRawBufferByteLength(buf->Metadata);
+      if (buf->StructureStride)
+        len = B.CreateUDiv(len, B.getInt32(buf->StructureStride));
+      s = B.CreateInsertValue(s, len, {0});
+      s = B.CreateInsertValue(s, B.getInt32(buf->StructureStride), {1});
+    }
+    result = s;
+    return llvm::Error::success();
+  }
+};
+
+} // namespace
+
+/* groupshared atomics are plain LLVM atomicrmw / cmpxchg in DXIL */
+static llvm::Error
+lower_llvm_atomics(llvm::Function &F, llvm::IRBuilder<> &B, AIRBuilder &air) {
+  std::vector<llvm::Instruction *> todo;
+  for (auto &I : llvm::instructions(F))
+    if (llvm::isa<llvm::AtomicRMWInst>(I) || llvm::isa<llvm::AtomicCmpXchgInst>(I))
+      todo.push_back(&I);
+  for (auto I : todo) {
+    B.SetInsertPoint(I);
+    if (auto rmw = llvm::dyn_cast<llvm::AtomicRMWInst>(I)) {
+      if (!rmw->getType()->isIntegerTy(32))
+        return unsupported("groupshared atomics are 32-bit only on Metal");
+      auto v = air.CreateAtomicRMW(rmw->getOperation(), rmw->getPointerOperand(), rmw->getValOperand());
+      if (!v)
+        return unsupported("groupshared atomicrmw");
+      rmw->replaceAllUsesWith(v);
+      rmw->eraseFromParent();
+    }
+    /* cmpxchg stays an LLVM instruction, the DXBC path emits the same */
+  }
+  return llvm::Error::success();
+}
+
+/* float <-> int conversions: D3D wants saturating ones, AIR's convert is that */
+static void
+lower_conversions(llvm::Function &F, llvm::IRBuilder<> &B, AIRBuilder &air) {
+  std::vector<llvm::Instruction *> todo;
+  for (auto &I : llvm::instructions(F)) {
+    switch (I.getOpcode()) {
+    case llvm::Instruction::FPToSI:
+    case llvm::Instruction::FPToUI:
+      if (I.getType()->isIntegerTy(32) && I.getOperand(0)->getType()->isFloatTy())
+        todo.push_back(&I);
+      break;
+    case llvm::Instruction::SIToFP:
+    case llvm::Instruction::UIToFP:
+      if (I.getType()->isFloatTy() && I.getOperand(0)->getType()->isIntegerTy(32))
+        todo.push_back(&I);
+      break;
+    default:
+      break;
+    }
+  }
+  for (auto I : todo) {
+    B.SetInsertPoint(I);
+    llvm::Value *v = nullptr;
+    switch (I->getOpcode()) {
+    case llvm::Instruction::FPToSI:
+      v = air.CreateConvertToSigned(I->getOperand(0));
+      break;
+    case llvm::Instruction::FPToUI:
+      v = air.CreateConvertToUnsigned(I->getOperand(0));
+      break;
+    case llvm::Instruction::SIToFP:
+      v = air.CreateConvertToFloat(I->getOperand(0), llvm::air::Signedness::Signed);
+      break;
+    case llvm::Instruction::UIToFP:
+      v = air.CreateConvertToFloat(I->getOperand(0), llvm::air::Signedness::Unsigned);
+      break;
+    }
+    I->replaceAllUsesWith(v);
+    I->eraseFromParent();
+  }
+}
+
+/* constant expressions on a global become instructions, so the global can be replaced */
+static void
+expand_constexpr_users(llvm::Constant *C) {
+  for (auto *U : llvm::make_early_inc_range(C->users())) {
+    auto CE = llvm::dyn_cast<llvm::ConstantExpr>(U);
+    if (!CE)
+      continue;
+    expand_constexpr_users(CE);
+    for (auto &use : llvm::make_early_inc_range(CE->uses())) {
+      auto I = llvm::dyn_cast<llvm::Instruction>(use.getUser());
+      if (!I)
+        continue;
+      llvm::Instruction *at = I;
+      if (auto phi = llvm::dyn_cast<llvm::PHINode>(I))
+        at = phi->getIncomingBlock(use)->getTerminator();
+      auto NI = CE->getAsInstruction(at);
+      use.set(NI);
+    }
+    if (CE->use_empty())
+      CE->destroyConstant();
+  }
+}
+
+/* re-roots GEP/load/bitcast chains on a pointer in another address space */
+static bool
+rewrite_pointer_uses(llvm::Value *Old, llvm::Value *New) {
+  unsigned as = New->getType()->getPointerAddressSpace();
+  for (auto &U : llvm::make_early_inc_range(Old->uses())) {
+    auto I = llvm::dyn_cast<llvm::Instruction>(U.getUser());
+    if (!I)
+      return false;
+    llvm::IRBuilder<> b(I);
+    if (auto gep = llvm::dyn_cast<llvm::GetElementPtrInst>(I)) {
+      llvm::SmallVector<llvm::Value *> idx(gep->indices());
+      auto ngep = b.CreateGEP(gep->getSourceElementType(), New, idx);
+      if (!rewrite_pointer_uses(gep, ngep))
+        return false;
+      gep->eraseFromParent();
+    } else if (auto ld = llvm::dyn_cast<llvm::LoadInst>(I)) {
+      auto nl = b.CreateLoad(ld->getType(), New);
+      ld->replaceAllUsesWith(nl);
+      ld->eraseFromParent();
+    } else if (auto bc = llvm::dyn_cast<llvm::BitCastInst>(I)) {
+      auto nbc = b.CreateBitCast(New, llvm::PointerType::get(bc->getType()->getNonOpaquePointerElementType(), as));
+      if (!rewrite_pointer_uses(bc, nbc))
+        return false;
+      bc->eraseFromParent();
+    } else {
+      return false;
+    }
+  }
+  return true;
+}
+
+llvm::Expected<llvm::BasicBlock *>
+EmitBody(SM50ShaderInternal *shader, struct dxbc::context &ctx, llvm::BasicBlock *return_bb) {
+  auto &context = ctx.llvm;
+  auto &module = ctx.module;
+  auto function = ctx.function;
+
+  auto dxil = ParseDXIL(shader->dxil_bitcode, context);
+  if (!dxil)
+    return unsupported("bitcode parse failed: " + llvm::toString(dxil.takeError()));
+  auto &dmod = **dxil;
+  auto main = dmod.getFunction(shader->dxil_entry);
+  if (!main)
+    return unsupported("entry function missing");
+
+  ResourceTable table;
+  {
+    SM50ShaderInternal scratch;
+    if (auto err = read_resources(dmod, &scratch, table))
+      return std::move(err);
+  }
+  std::vector<SigElement> inputs, outputs;
+  if (auto entries = dmod.getNamedMetadata("dx.entryPoints")) {
+    if (auto sigs = llvm::dyn_cast_or_null<llvm::MDNode>(entries->getOperand(0)->getOperand(2).get())) {
+      inputs = read_signature(sigs->getOperand(0));
+      outputs = read_signature(sigs->getOperand(1));
+    }
+  }
+
+  /* groupshared variables become threadgroup globals of the AIR module */
+  for (auto &gv : llvm::make_early_inc_range(dmod.globals())) {
+    if (gv.use_empty())
+      continue;
+    if (gv.getAddressSpace() == 0)
+      continue; /* static globals: below, after the body moved */
+    if (gv.getAddressSpace() != 3)
+      return unsupported("global variable in address space " + llvm::Twine(gv.getAddressSpace()));
+    auto ngv = new llvm::GlobalVariable(
+        module, gv.getValueType(), false, llvm::GlobalValue::InternalLinkage, llvm::UndefValue::get(gv.getValueType()),
+        gv.getName(), nullptr, llvm::GlobalValue::NotThreadLocal, 3
+    );
+    ngv->setAlignment(llvm::MaybeAlign(gv.getAlign() ? gv.getAlign()->value() : 4));
+    gv.replaceAllUsesWith(ngv);
+  }
+
+  /* move the body, returns go to the epilogue */
+  llvm::BasicBlock *body_entry = &main->getEntryBlock();
+  function->getBasicBlockList().splice(function->end(), main->getBasicBlockList());
+  std::vector<llvm::ReturnInst *> rets;
+  for (auto &I : llvm::instructions(*function)) {
+    llvm::SmallVector<std::pair<unsigned, llvm::MDNode *>> mds;
+    I.getAllMetadata(mds);
+    for (auto &[kind, _] : mds)
+      I.setMetadata(kind, nullptr);
+    if (auto ret = llvm::dyn_cast<llvm::ReturnInst>(&I))
+      rets.push_back(ret);
+  }
+  for (auto ret : rets) {
+    llvm::BranchInst::Create(return_bb, ret);
+    ret->eraseFromParent();
+  }
+  /* DXIL's local arrays live in its entry block; move them to the function entry so
+     they stay static allocas (mem2reg/SROA) */
+  {
+    auto &entry = function->getEntryBlock();
+    for (auto &I : llvm::make_early_inc_range(*body_entry))
+      if (auto a = llvm::dyn_cast<llvm::AllocaInst>(&I); a && llvm::isa<llvm::Constant>(a->getArraySize()))
+        a->moveBefore(entry, entry.getFirstInsertionPt());
+  }
+
+  auto &builder = ctx.builder;
+  auto saved_ip = builder.saveIP();
+
+  /* static globals: constant ones go to the constant address space, mutable
+     ones (per thread in HLSL) become allocas */
+  for (auto &gv : llvm::make_early_inc_range(dmod.globals())) {
+    if (gv.use_empty() || gv.getAddressSpace() != 0)
+      continue;
+    expand_constexpr_users(&gv);
+    if (gv.isConstant() && gv.hasInitializer()) {
+      auto ngv = new llvm::GlobalVariable(
+          module, gv.getValueType(), true, llvm::GlobalValue::InternalLinkage, gv.getInitializer(), gv.getName(),
+          nullptr, llvm::GlobalValue::NotThreadLocal, 2
+      );
+      ngv->setAlignment(llvm::MaybeAlign(16));
+      if (!rewrite_pointer_uses(&gv, ngv))
+        return unsupported("unsupported use of a static const array");
+    } else {
+      builder.restoreIP(saved_ip);
+      auto slot = builder.CreateAlloca(gv.getValueType());
+      if (gv.hasInitializer() && !llvm::isa<llvm::UndefValue>(gv.getInitializer()))
+        builder.CreateStore(gv.getInitializer(), slot);
+      saved_ip = builder.saveIP();
+      gv.replaceAllUsesWith(slot);
+    }
+  }
+  Converter conv(ctx.air, ctx, ctx.resource);
+  Lowering lowering(builder, ctx.air, conv, ctx.binding, table, shader->shader_info);
+  lowering.ctx = &ctx;
+  lowering.inputs = &inputs;
+  lowering.outputs = &outputs;
+  lowering.lane = ~shader->dxil_lane_arg ? function->getArg(shader->dxil_lane_arg) : nullptr;
+  lowering.lanes = ~shader->dxil_lanes_arg ? function->getArg(shader->dxil_lanes_arg) : nullptr;
+  lowering.shader_sample_index_arg = shader->dxil_sample_index_arg;
+
+  /* Metal has no 64-bit floats; the device reports DoublePrecisionFloatShaderOps = FALSE */
+  for (auto &I : llvm::instructions(*function)) {
+    if (I.getType()->isDoubleTy())
+      return unsupported("double precision is not supported on Metal");
+    for (auto &op : I.operands())
+      if (op->getType()->isDoubleTy())
+        return unsupported("double precision is not supported on Metal");
+  }
+
+  std::vector<llvm::CallInst *> calls;
+  for (auto &I : llvm::instructions(*function))
+    if (auto call = llvm::dyn_cast<llvm::CallInst>(&I))
+      if (dx_opcode(call) != ~0u)
+        calls.push_back(call);
+  std::vector<llvm::CallInst *> handles;
+  for (auto call : calls) {
+    builder.SetInsertPoint(call);
+    llvm::Value *result = nullptr;
+    if (auto err = lowering.lower(call, result))
+      return std::move(err);
+    auto opc = dx_opcode(call);
+    if (opc == op::CreateHandle || opc == op::CreateHandleFromBinding || opc == op::AnnotateHandle || opc == 218) {
+      handles.push_back(call);
+      continue;
+    }
+    if (result)
+      call->replaceAllUsesWith(result);
+    else if (!call->use_empty())
+      return unsupported("operation " + llvm::Twine(opc) + " has users but no result");
+    call->eraseFromParent();
+  }
+  for (auto it = handles.rbegin(); it != handles.rend(); ++it) {
+    if (!(*it)->use_empty())
+      (*it)->replaceAllUsesWith(llvm::UndefValue::get((*it)->getType()));
+    (*it)->eraseFromParent();
+  }
+  if (auto err = lower_llvm_atomics(*function, builder, ctx.air))
+    return std::move(err);
+  lower_conversions(*function, builder, ctx.air);
+  builder.restoreIP(saved_ip);
+
+  /* LLVM intrinsics of the DXIL module: lifetime markers go, others are redeclared here */
+  for (auto &I : llvm::make_early_inc_range(llvm::instructions(*function))) {
+    auto call = llvm::dyn_cast<llvm::CallInst>(&I);
+    if (!call || !call->getCalledFunction() || call->getCalledFunction()->getParent() == &module)
+      continue;
+    auto callee = call->getCalledFunction();
+    if (callee->getName().startswith("llvm.lifetime.") || callee->getName().startswith("llvm.dbg.")) {
+      call->eraseFromParent();
+      continue;
+    }
+    call->setCalledFunction(module.getOrInsertFunction(callee->getName(), callee->getFunctionType(), callee->getAttributes()));
+  }
+
+  /* nothing may point into the DXIL module any more */
+  for (auto &I : llvm::instructions(*function))
+    for (auto &op : I.operands())
+      if (auto g = llvm::dyn_cast<llvm::GlobalValue>(op.get()); g && g->getParent() != &module) {
+        std::string msg;
+        llvm::raw_string_ostream os(msg);
+        I.print(os);
+        return unsupported("left a reference to " + g->getName() + " in: " + os.str());
+      }
+
+  if (lowering.used_msad)
+    shader->shader_info.use_msad = true;
+  if (lowering.used_samplepos)
+    shader->shader_info.use_samplepos = true;
+  if (lowering.needs_air_2_9) {
+    auto &C = module.getContext();
+    auto u = [&](uint32_t v) { return llvm::ConstantAsMetadata::get(llvm::ConstantInt::get(C, llvm::APInt{32, v, false})); };
+    auto ver = module.getOrInsertNamedMetadata("air.version");
+    ver->clearOperands();
+    ver->addOperand(llvm::MDTuple::get(C, {u(2), u(9), u(0)}));
+    module.setTargetTriple("air64-apple-macosx27.0.0");
+  }
+
+  dxil->reset();
+  return body_entry;
+}
