+static llvm::Error
+unsupported(const llvm::Twine &msg) {
+  return llvm::make_error<UnsupportedFeature>(("DXIL: " + msg).str());
+}
+
+bool
+ExtractDXIL(const void *pBytecode, size_t BytecodeSize, std::vector<char> &Bitcode, uint32_t &ProgramVersion) {
+  microsoft::CDXBCParser Parser;
+  if (Parser.ReadDXBC(pBytecode, BytecodeSize) != S_OK)
+    return false;
+  UINT idx = Parser.FindNextMatchingBlob(microsoft::DXBC_DXIL);
+  if (idx == DXBC_BLOB_NOT_FOUND)
+    return false;
+  auto *blob = (const char *)Parser.GetBlob(idx);
+  auto size = Parser.GetBlobSize(idx);
+  if (size < 24)
+    return false;
+  /* DxilProgramHeader: ProgramVersion, SizeInUint32, then DxilBitcodeHeader:
+     magic 'DXIL', version, offset (from the bitcode header), size */
+  uint32_t offset, bc_size;
+  memcpy(&ProgramVersion, blob, 4);
+  memcpy(&offset, blob + 16, 4);
+  memcpy(&bc_size, blob + 20, 4);
+  if (8 + offset + bc_size > size)
+    return false;
+  Bitcode.assign(blob + 8 + offset, blob + 8 + offset + bc_size);
+  return true;
+}
+
+static llvm::Expected<std::unique_ptr<llvm::Module>>
+ParseDXIL(const std::vector<char> &Bitcode, llvm::LLVMContext &Context) {
+  auto buffer = llvm::MemoryBuffer::getMemBuffer(llvm::StringRef(Bitcode.data(), Bitcode.size()), "dxil", false);
+  return llvm::parseBitcodeFile(buffer->getMemBufferRef(), Context);
+}
+
+static uint32_t
+md_uint(const llvm::MDOperand &op) {
+  if (auto c = llvm::mdconst::dyn_extract_or_null<llvm::ConstantInt>(op))
+    return (uint32_t)c->getZExtValue();
+  return 0;
+}
+
+static bool
+md_bool(const llvm::MDOperand &op) {
+  if (auto c = llvm::mdconst::dyn_extract_or_null<llvm::ConstantInt>(op))
+    return !c->isZero();
+  return false;
+}
+
+struct ExtProps {
+  uint32_t component_type = CT_Invalid;
+  uint32_t stride = 0;
+};
+
+static ExtProps
+read_ext(const llvm::MDOperand &op) {
+  ExtProps r;
+  auto node = llvm::dyn_cast_or_null<llvm::MDNode>(op.get());
+  if (!node)
+    return r;
+  for (unsigned i = 0; i + 1 < node->getNumOperands(); i += 2) {
+    switch (md_uint(node->getOperand(i))) {
+    case 0:
+      r.component_type = md_uint(node->getOperand(i + 1));
+      break;
+    case 1:
+      r.stride = md_uint(node->getOperand(i + 1));
+      break;
+    }
+  }
+  return r;
+}
+
+static ScalerDataType
+scaler_type(uint32_t ct) {
+  switch (ct) {
+  case CT_I16:
+  case CT_I32:
+  case CT_I64:
+    return ScalerDataType::Int;
+  case CT_U16:
+  case CT_U32:
+  case CT_U64:
+  case CT_I1:
+    return ScalerDataType::Uint;
+  case CT_F64:
+    return ScalerDataType::Double;
+  default:
+    return ScalerDataType::Float;
+  }
+}
+
+static llvm::Expected<ResourceType>
+resource_type(uint32_t kind) {
+  switch (kind) {
+  case RK_Texture1D:
+    return ResourceType::Texture1D;
+  case RK_Texture2D:
+    return ResourceType::Texture2D;
+  case RK_Texture2DMS:
+    return ResourceType::Texture2DMultisampled;
+  case RK_Texture3D:
+    return ResourceType::Texture3D;
+  case RK_TextureCube:
+    return ResourceType::TextureCube;
+  case RK_Texture1DArray:
+    return ResourceType::Texture1DArray;
+  case RK_Texture2DArray:
+    return ResourceType::Texture2DArray;
+  case RK_Texture2DMSArray:
+    return ResourceType::Texture2DMultisampledArray;
+  case RK_TextureCubeArray:
+    return ResourceType::TextureCubeArray;
+  case RK_TypedBuffer:
+    return ResourceType::TextureBuffer;
+  case RK_RawBuffer:
+  case RK_StructuredBuffer:
+    return ResourceType::NonApplicable;
+  default:
+    return unsupported("resource kind " + llvm::Twine(kind));
+  }
+}
+
+static uint32_t
+dx_opcode(llvm::CallInst *call) {
+  auto fn = call->getCalledFunction();
+  if (!fn || !fn->getName().startswith("dx.op.") || call->arg_size() == 0)
+    return ~0u;
+  if (auto c = llvm::dyn_cast<llvm::ConstantInt>(call->getArgOperand(0)))
+    return (uint32_t)c->getZExtValue();
+  return ~0u;
+}
