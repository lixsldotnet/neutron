+  bool heap = false;
+  uint32_t props0 = 0, props1 = 0;
+};
+
+struct ResourceTable {
+  /* per class: (space, lower bound, size, id) for createHandleFromBinding */
+  struct Entry {
+    uint32_t space, lower, size, id;
+  };
+  std::vector<Entry> entries[4];
+};
+
+/* Resolves a dx.types.Handle value to the resource declaration it refers to. */
+static llvm::Optional<HandleInfo>
+resolve_handle(llvm::Value *v, const ResourceTable &table) {
+  auto call = llvm::dyn_cast<llvm::CallInst>(v);
+  if (!call)
+    return {};
+  switch (dx_opcode(call)) {
+  case op::CreateHandle: {
+    auto cls = (uint32_t)llvm::cast<llvm::ConstantInt>(call->getArgOperand(1))->getZExtValue();
+    auto id = (uint32_t)llvm::cast<llvm::ConstantInt>(call->getArgOperand(2))->getZExtValue();
+    return HandleInfo{cls, id, call->getArgOperand(3)};
+  }
+  case op::AnnotateHandle: {
+    auto h = resolve_handle(call->getArgOperand(1), table);
+    if (h && h->heap) {
+      if (auto props = llvm::dyn_cast<llvm::Constant>(call->getArgOperand(2))) {
+        auto field = [&](unsigned i) -> uint32_t {
+          auto e = props->getAggregateElement(i);
+          if (auto c = llvm::dyn_cast_or_null<llvm::ConstantInt>(e))
+            return (uint32_t)c->getZExtValue();
+          return 0;
+        };
+        h->props0 = field(0);
+        h->props1 = field(1);
+        uint32_t kind = h->props0 & 0xff;
+        bool is_uav = (h->props0 >> 12) & 1;
+        if (kind == RK_Sampler)
+          h->cls = Sampler;
+        else if (kind == RK_CBuffer)
+          h->cls = CBuffer;
+        else
+          h->cls = is_uav ? UAV : SRV;
+      }
+    }
+    return h;
+  }
+  case 218 /* createHandleFromHeap(index, sampler heap, non uniform) */: {
+    HandleInfo h{~0u, 0, call->getArgOperand(1)};
+    h.heap = true;
+    if (auto c = llvm::dyn_cast<llvm::ConstantInt>(call->getArgOperand(2)); c && !c->isZero())
+      h.cls = Sampler;
+    return h;
+  }
+  case op::CreateHandleFromBinding: {
+    auto bind = llvm::dyn_cast<llvm::Constant>(call->getArgOperand(1));
+    if (!bind)
+      return {};
+    auto field = [&](unsigned i) -> uint32_t {
+      auto e = bind->getAggregateElement(i);
+      if (auto c = llvm::dyn_cast_or_null<llvm::ConstantInt>(e))
+        return (uint32_t)c->getZExtValue();
+      return 0;
+    };
+    uint32_t lower = field(0), space = field(2), cls = field(3);
+    if (cls > 3)
+      return {};
+    for (auto &e : table.entries[cls]) {
+      if (e.space == space && e.lower == lower)
+        return HandleInfo{cls, e.id, call->getArgOperand(2)};
+    }
+    return {};
+  }
+  default:
+    return {};
+  }
+}
+
+/* --- Initialize: metadata into ShaderInfo --- */
+
+static llvm::Error
+read_resources(llvm::Module &M, SM50ShaderInternal *shader, ResourceTable &table) {
+  auto &info = shader->shader_info;
+  auto resources = M.getNamedMetadata("dx.resources");
+  if (!resources || resources->getNumOperands() == 0)
+    return llvm::Error::success();
+  auto lists = resources->getOperand(0);
+  for (unsigned cls = 0; cls < 4 && cls < lists->getNumOperands(); cls++) {
+    auto list = llvm::dyn_cast_or_null<llvm::MDNode>(lists->getOperand(cls).get());
+    if (!list)
+      continue;
+    for (auto &rop : list->operands()) {
+      auto r = llvm::cast<llvm::MDNode>(rop.get());
+      ResourceRange range{
+          .range_id = md_uint(r->getOperand(0)),
+          .lower_bound = md_uint(r->getOperand(4)),
+          .size = md_uint(r->getOperand(5)),
+          .space = md_uint(r->getOperand(3)),
+      };
+      table.entries[cls].push_back({range.space, range.lower_bound, range.size, range.range_id});
+      switch (cls) {
+      case SRV: {
+        auto kind = md_uint(r->getOperand(6));
+        auto ext = read_ext(r->getOperand(8));
+        auto type = resource_type(kind);
+        if (!type)
+          return type.takeError();
+        ShaderResourceViewInfo srv{};
+        srv.range = range;
+        srv.scaler_type = scaler_type(ext.component_type);
+        srv.resource_type = *type;
+        srv.read = true;
+        srv.structure_stride = kind == RK_StructuredBuffer ? ext.stride : 0;
+        info.srvMap[range.range_id] = srv;
+        break;
+      }
+      case UAV: {
+        auto kind = md_uint(r->getOperand(6));
+        auto ext = read_ext(r->getOperand(10));
+        auto type = resource_type(kind);
+        if (!type)
+          return type.takeError();
+        UnorderedAccessViewInfo uav{};
+        uav.range = range;
+        uav.scaler_type = scaler_type(ext.component_type);
+        uav.resource_type = *type;
+        uav.global_coherent = md_bool(r->getOperand(7));
+        uav.with_counter = md_bool(r->getOperand(8));
+        uav.rasterizer_order = md_bool(r->getOperand(9));
+        uav.structure_stride = kind == RK_StructuredBuffer ? ext.stride : 0;
+        info.uavMap[range.range_id] = uav;
+        break;
+      }
+      case CBuffer: {
+        ConstantBufferInfo cb{};
+        cb.range = range;
+        cb.size_in_vec4 = (md_uint(r->getOperand(6)) + 15) / 16;
+        info.cbufferMap[range.range_id] = cb;
+        break;
+      }
+      case Sampler: {
+        SamplerInfo s{};
+        s.range = range;
+        info.samplerMap[range.range_id] = s;
+        break;
+      }
+      }
+    }
+  }
+  return llvm::Error::success();
+}
+
+/* How the shader uses its resources decides the Metal access qualifiers. */
+static void
+scan_resource_usage(llvm::Function &F, SM50ShaderInternal *shader, const ResourceTable &table) {
+  auto &info = shader->shader_info;
+  for (auto &I : llvm::instructions(F)) {
+    auto call = llvm::dyn_cast<llvm::CallInst>(&I);
+    if (!call)
+      continue;
+    auto opc = dx_opcode(call);
+    if (opc == ~0u || call->arg_size() < 2)
+      continue;
+    auto h = resolve_handle(call->getArgOperand(1), table);
+    if (!h || h->heap)
+      continue;
+    if (h->cls == SRV) {
+      auto it = info.srvMap.find(h->range_id);
+      if (it == info.srvMap.end())
+        continue;
+      if ((opc >= 60 && opc <= 65) || opc == 73 || opc == 74 || opc == 81 || opc == 224)
+        it->second.sampled = true;
+      if (opc == 64 || opc == 65 || opc == 74 || opc == 224)
+        it->second.compared = true;
+    } else if (h->cls == UAV) {
+      auto it = info.uavMap.find(h->range_id);
+      if (it == info.uavMap.end())
+        continue;
+      switch (opc) {
+      case op::TextureLoad:
+      case op::BufferLoad:
+      case op::RawBufferLoad:
+        it->second.read = true;
+        break;
+      case op::TextureStore:
+      case op::BufferStore:
+      case op::RawBufferStore:
+        it->second.written = true;
+        break;
+      case op::AtomicBinOp:
+      case op::AtomicCompareExchange:
+        it->second.read = it->second.written = true;
+        break;
+      default:
+        break;
+      }
+    }
+  }
+}
+
+/* DXIL signature element (dx.entryPoints signatures) */
+struct SigElement {
+  uint32_t id;
+  uint32_t comp_type;
+  uint32_t kind; /* DXIL::SemanticKind */
+  uint32_t interp;
+  uint32_t rows, cols;
+  int32_t start_row;
+  int32_t start_col;
+};
+
+namespace sk {
+enum : uint32_t {
+  Arbitrary = 0,
+  VertexID = 1,
+  InstanceID = 2,
+  Position = 3,
+  RenderTargetArrayIndex = 4,
+  ViewPortArrayIndex = 5,
+  ClipDistance = 6,
+  CullDistance = 7,
+  PrimitiveID = 10,
+  SampleIndex = 12,
+  IsFrontFace = 13,
+  Coverage = 14,
+  InnerCoverage = 15,
+  Target = 16,
+  Depth = 17,
+  DepthLessEqual = 18,
+  DepthGreaterEqual = 19,
+  StencilRef = 20,
+};
+}
+
+static std::vector<SigElement>
+read_signature(const llvm::MDOperand &op) {
+  std::vector<SigElement> r;
+  auto list = llvm::dyn_cast_or_null<llvm::MDNode>(op.get());
+  if (!list)
+    return r;
+  for (auto &eop : list->operands()) {
+    auto e = llvm::cast<llvm::MDNode>(eop.get());
+    SigElement s;
+    s.id = md_uint(e->getOperand(0));
+    s.comp_type = md_uint(e->getOperand(2));
+    s.kind = md_uint(e->getOperand(3));
+    s.interp = md_uint(e->getOperand(5));
+    s.rows = md_uint(e->getOperand(6));
+    s.cols = md_uint(e->getOperand(7));
+    s.start_row = (int32_t)md_uint(e->getOperand(8));
+    s.start_col = (int8_t)md_uint(e->getOperand(9));
+    r.push_back(s);
+  }
+  return r;
+}
+
+/* A DXBC declaration instruction for one signature row, fed to the DXBC
+   signature handlers so DXIL shaders get the same inputs/outputs plumbing. */
+static microsoft::D3D10ShaderBinary::CInstruction
+make_decl(microsoft::D3D10_SB_OPCODE_TYPE opcode, microsoft::D3D10_SB_OPERAND_TYPE type, uint32_t reg, uint32_t mask) {
+  microsoft::D3D10ShaderBinary::CInstruction inst;
+  memset((void *)&inst, 0, sizeof(inst));
+  inst.m_OpCode = opcode;
+  inst.m_NumOperands = 1;
+  auto &o = inst.m_Operands[0];
+  o.m_Type = type;
+  o.m_IndexDimension = microsoft::D3D10_SB_OPERAND_INDEX_1D;
+  o.m_Index[0].m_RegIndex = reg;
+  o.m_WriteMask = mask << 4;
+  o.m_NumComponents = microsoft::D3D10_SB_OPERAND_4_COMPONENT;
+  return inst;
+}
+
+static uint32_t
+row_mask(const SigElement &e) {
+  return ((1u << e.cols) - 1) << (e.start_col < 0 ? 0 : e.start_col);
+}
+
+static llvm::Error
+synthesize_signature(
+    SM50ShaderInternal *shader, microsoft::CSignatureParser &in, microsoft::CSignatureParser5 &out,
+    const std::vector<SigElement> &inputs, const std::vector<SigElement> &outputs
+) {
+  using namespace microsoft;
+  auto emit = [&](D3D10ShaderBinary::CInstruction inst) { handle_signature(in, out, inst, shader, 0); };
+  bool vs = shader->shader_type == D3D10_SB_VERTEX_SHADER;
+  bool ps = shader->shader_type == D3D10_SB_PIXEL_SHADER;
+
+  for (auto &e : inputs) {
+    if (e.start_row < 0) {
+      if (ps && e.kind == sk::Coverage) {
+        emit(make_decl(D3D10_SB_OPCODE_DCL_INPUT, D3D11_SB_OPERAND_TYPE_INPUT_COVERAGE_MASK, 0, 1));
+        continue;
+      }
+      if (ps && e.kind == sk::SampleIndex)
+        continue; /* dx.op.sampleIndex */
+      return unsupported("input semantic kind " + llvm::Twine(e.kind) + " without register");
+    }
+    for (uint32_t r = 0; r < e.rows; r++) {
+      uint32_t reg = e.start_row + r, mask = row_mask(e);
+      if (vs) {
+        switch (e.kind) {
+        case sk::Arbitrary:
+          emit(make_decl(D3D10_SB_OPCODE_DCL_INPUT, D3D10_SB_OPERAND_TYPE_INPUT, reg, mask));
+          break;
+        case sk::VertexID:
+        case sk::InstanceID: {
+          auto inst = make_decl(D3D10_SB_OPCODE_DCL_INPUT_SGV, D3D10_SB_OPERAND_TYPE_INPUT, reg, mask);
+          inst.m_InputDeclSGV.Name = e.kind == sk::VertexID ? D3D10_SB_NAME_VERTEX_ID : D3D10_SB_NAME_INSTANCE_ID;
+          emit(inst);
+          break;
+        }
+        default:
+          return unsupported("vertex input semantic kind " + llvm::Twine(e.kind));
+        }
+      } else if (ps) {
+        auto interp = (D3D10_SB_INTERPOLATION_MODE)e.interp;
+        switch (e.kind) {
+        case sk::Arbitrary: {
+          auto inst = make_decl(D3D10_SB_OPCODE_DCL_INPUT_PS, D3D10_SB_OPERAND_TYPE_INPUT, reg, mask);
+          inst.m_InputPSDecl.InterpolationMode = interp;
+          emit(inst);
+          break;
+        }
+        case sk::Position:
+        case sk::RenderTargetArrayIndex:
+        case sk::ViewPortArrayIndex:
+        case sk::ClipDistance:
+        case sk::CullDistance: {
+          auto inst = make_decl(D3D10_SB_OPCODE_DCL_INPUT_PS_SIV, D3D10_SB_OPERAND_TYPE_INPUT, reg, mask);
+          inst.m_InputPSDeclSIV.Name = e.kind == sk::Position                 ? D3D10_SB_NAME_POSITION
+                                       : e.kind == sk::RenderTargetArrayIndex ? D3D10_SB_NAME_RENDER_TARGET_ARRAY_INDEX
+                                       : e.kind == sk::ViewPortArrayIndex     ? D3D10_SB_NAME_VIEWPORT_ARRAY_INDEX
+                                       : e.kind == sk::ClipDistance           ? D3D10_SB_NAME_CLIP_DISTANCE
+                                                                              : D3D10_SB_NAME_CULL_DISTANCE;
+          inst.m_InputPSDeclSIV.InterpolationMode = interp;
+          emit(inst);
+          break;
+        }
+        case sk::IsFrontFace:
+        case sk::SampleIndex:
+        case sk::PrimitiveID: {
+          auto inst = make_decl(D3D10_SB_OPCODE_DCL_INPUT_PS_SGV, D3D10_SB_OPERAND_TYPE_INPUT, reg, mask);
+          inst.m_InputPSDeclSGV.Name = e.kind == sk::IsFrontFace   ? D3D10_SB_NAME_IS_FRONT_FACE
+                                       : e.kind == sk::SampleIndex ? D3D10_SB_NAME_SAMPLE_INDEX
+                                                                   : D3D10_SB_NAME_PRIMITIVE_ID;
+          inst.m_InputPSDeclSGV.InterpolationMode = D3D10_SB_INTERPOLATION_CONSTANT;
+          emit(inst);
+          break;
+        }
+        default:
+          return unsupported("pixel input semantic kind " + llvm::Twine(e.kind));
+        }
+      }
+    }
+  }
+
+  for (auto &e : outputs) {
+    if (ps && e.start_row < 0) {
+      switch (e.kind) {
+      case sk::Depth:
+        emit(make_decl(D3D10_SB_OPCODE_DCL_OUTPUT, D3D10_SB_OPERAND_TYPE_OUTPUT_DEPTH, 0, 1));
+        continue;
+      case sk::DepthLessEqual:
+        emit(make_decl(D3D10_SB_OPCODE_DCL_OUTPUT, D3D11_SB_OPERAND_TYPE_OUTPUT_DEPTH_LESS_EQUAL, 0, 1));
+        continue;
+      case sk::DepthGreaterEqual:
+        emit(make_decl(D3D10_SB_OPCODE_DCL_OUTPUT, D3D11_SB_OPERAND_TYPE_OUTPUT_DEPTH_GREATER_EQUAL, 0, 1));
+        continue;
+      case sk::Coverage:
+        emit(make_decl(D3D10_SB_OPCODE_DCL_OUTPUT, D3D10_SB_OPERAND_TYPE_OUTPUT_COVERAGE_MASK, 0, 1));
+        continue;
+      case sk::StencilRef:
+        emit(make_decl(D3D10_SB_OPCODE_DCL_OUTPUT, D3D11_SB_OPERAND_TYPE_OUTPUT_STENCIL_REF, 0, 1));
+        continue;
+      default:
+        return unsupported("pixel output semantic kind " + llvm::Twine(e.kind));
+      }
+    }
+    if (e.start_row < 0)
+      return unsupported("output semantic kind " + llvm::Twine(e.kind) + " without register");
+    for (uint32_t r = 0; r < e.rows; r++) {
+      uint32_t reg = e.start_row + r, mask = row_mask(e);
+      if (vs) {
+        switch (e.kind) {
+        case sk::Arbitrary:
+          emit(make_decl(D3D10_SB_OPCODE_DCL_OUTPUT, D3D10_SB_OPERAND_TYPE_OUTPUT, reg, mask));
+          break;
+        case sk::Position:
+        case sk::RenderTargetArrayIndex:
+        case sk::ViewPortArrayIndex:
+        case sk::ClipDistance:
+        case sk::CullDistance: {
+          auto inst = make_decl(D3D10_SB_OPCODE_DCL_OUTPUT_SIV, D3D10_SB_OPERAND_TYPE_OUTPUT, reg, mask);
+          inst.m_OutputDeclSIV.Name = e.kind == sk::Position                 ? D3D10_SB_NAME_POSITION
+                                      : e.kind == sk::RenderTargetArrayIndex ? D3D10_SB_NAME_RENDER_TARGET_ARRAY_INDEX
+                                      : e.kind == sk::ViewPortArrayIndex     ? D3D10_SB_NAME_VIEWPORT_ARRAY_INDEX
+                                      : e.kind == sk::ClipDistance           ? D3D10_SB_NAME_CLIP_DISTANCE
+                                                                             : D3D10_SB_NAME_CULL_DISTANCE;
+          emit(inst);
+          break;
+        }
+        default:
+          return unsupported("vertex output semantic kind " + llvm::Twine(e.kind));
+        }
+      } else if (ps) {
+        if (e.kind != sk::Target)
+          return unsupported("pixel output semantic kind " + llvm::Twine(e.kind));
+        emit(make_decl(D3D10_SB_OPCODE_DCL_OUTPUT, D3D10_SB_OPERAND_TYPE_OUTPUT, reg, mask));
+      }
+    }
+  }
+  return llvm::Error::success();
+}
+
+int
+InitializeShader(
+    const void *pBytecode, size_t BytecodeSize, SM50ShaderInternal *shader, microsoft::CSignatureParser &inputParser,
+    microsoft::CSignatureParser5 &outputParser, llvm::raw_ostream &errorOut
+) {
+  using namespace microsoft;
+  uint32_t version = 0;
+  if (!ExtractDXIL(pBytecode, BytecodeSize, shader->dxil_bitcode, version)) {
+    errorOut << "DXIL: invalid DXIL part";
+    return 1;
+  }
+  shader->is_dxil = true;
+  shader->dxil_container.assign((const char *)pBytecode, (const char *)pBytecode + BytecodeSize);
+
+  llvm::LLVMContext context;
+  context.setOpaquePointers(false);
+  auto M = ParseDXIL(shader->dxil_bitcode, context);
+  if (!M) {
+    errorOut << "DXIL: bitcode parse failed: " << llvm::toString(M.takeError());
+    return 1;
+  }
+  auto &mod = **M;
+
+  uint32_t kind = version >> 16;
+  switch (kind) {
+  case 0:
+    shader->shader_type = D3D10_SB_PIXEL_SHADER;
+    break;
+  case 1:
+    shader->shader_type = D3D10_SB_VERTEX_SHADER;
+    break;
+  case 5:
+    shader->shader_type = D3D11_SB_COMPUTE_SHADER;
+    break;
+  default: {
+    static const char *names[] = {"pixel", "vertex", "geometry", "hull", "domain", "compute"};
+    errorOut << "DXIL: " << (kind < 6 ? names[kind] : "library/mesh/amplification")
+             << " shaders are not supported yet";
+    return 1;
+  }
+  }
+
+  auto entries = mod.getNamedMetadata("dx.entryPoints");
+  if (!entries || entries->getNumOperands() == 0) {
+    errorOut << "DXIL: no entry point";
+    return 1;
+  }
+  auto entry = entries->getOperand(0);
+  auto fn = llvm::mdconst::dyn_extract_or_null<llvm::Function>(entry->getOperand(0));
+  if (!fn) {
+    errorOut << "DXIL: entry point without function";
+    return 1;
+  }
+  shader->dxil_entry = fn->getName().str();
+  if (auto props = llvm::dyn_cast_or_null<llvm::MDNode>(entry->getOperand(4).get())) {
+    for (unsigned i = 0; i + 1 < props->getNumOperands(); i += 2) {
+      auto tag = md_uint(props->getOperand(i));
+      if (tag == 4 /* NumThreads */) {
+        auto nt = llvm::cast<llvm::MDNode>(props->getOperand(i + 1).get());
+        for (unsigned d = 0; d < 3; d++)
+          shader->threadgroup_size[d] = md_uint(nt->getOperand(d));
+      }
+    }
+  }
+
+  ResourceTable table;
+  if (auto err = read_resources(mod, shader, table)) {
+    errorOut << llvm::toString(std::move(err));
+    return 1;
+  }
+  scan_resource_usage(*fn, shader, table);
+
+  /* inputs and outputs through the DXBC signature handlers */
+  if (shader->shader_type == D3D11_SB_COMPUTE_SHADER) {
+    for (auto type : {D3D11_SB_OPERAND_TYPE_INPUT_THREAD_ID, D3D11_SB_OPERAND_TYPE_INPUT_THREAD_GROUP_ID,
+                      D3D11_SB_OPERAND_TYPE_INPUT_THREAD_ID_IN_GROUP,
+                      D3D11_SB_OPERAND_TYPE_INPUT_THREAD_ID_IN_GROUP_FLATTENED}) {
+      auto inst = make_decl(D3D10_SB_OPCODE_DCL_INPUT, type, 0, 0);
+      inst.m_Operands[0].m_IndexDimension = D3D10_SB_OPERAND_INDEX_0D;
+      handle_signature(inputParser, outputParser, inst, shader, 0);
+    }
+  } else {
+    auto sigs = llvm::dyn_cast_or_null<llvm::MDNode>(entry->getOperand(2).get());
+    std::vector<SigElement> inputs, outputs;
+    if (sigs) {
+      inputs = read_signature(sigs->getOperand(0));
+      outputs = read_signature(sigs->getOperand(1));
+    }
+    if (auto err = synthesize_signature(shader, inputParser, outputParser, inputs, outputs)) {
+      errorOut << llvm::toString(std::move(err));
+      return 1;
+    }
+  }
+
+  /* SV_Coverage input is an operation in DXIL, not a signature element */
+  if (shader->shader_type == D3D10_SB_PIXEL_SHADER) {
+    for (auto &I : llvm::instructions(*fn))
+      if (auto call = llvm::dyn_cast<llvm::CallInst>(&I); call && dx_opcode(call) == op::Coverage) {
+        auto inst = make_decl(D3D10_SB_OPCODE_DCL_INPUT, D3D11_SB_OPERAND_TYPE_INPUT_COVERAGE_MASK, 0, 1);
+        inst.m_Operands[0].m_IndexDimension = D3D10_SB_OPERAND_INDEX_0D;
+        handle_signature(inputParser, outputParser, inst, shader, 0);
+        break;
+      }
+  }
+
+  /* SV_SampleIndex is an operation too */
+  if (shader->shader_type == D3D10_SB_PIXEL_SHADER) {
+    for (auto &I : llvm::instructions(*fn))
+      if (auto call = llvm::dyn_cast<llvm::CallInst>(&I); call && dx_opcode(call) == 90) {
+        shader->dxil_sample_index_arg = shader->func_signature.DefineInput(air::InputSampleIndex{});
+        break;
+      }
+  }
+
+  /* wave intrinsics need the simdgroup lane and size */
+  bool uses_wave = false;
+  for (auto &I : llvm::instructions(*fn))
+    if (auto call = llvm::dyn_cast<llvm::CallInst>(&I)) {
+      auto opc = dx_opcode(call);
+      if ((opc >= 110 && opc <= 123) || opc == 135 || opc == 136)
+        uses_wave = true;
+      /* compute derivatives are emulated with quad shuffles */
+      if (shader->shader_type == D3D11_SB_COMPUTE_SHADER &&
+          (opc == 60 || opc == 61 || opc == 64 || (opc >= 83 && opc <= 86)))
+        uses_wave = true;
+    }
+  if (uses_wave && (shader->shader_type == D3D11_SB_COMPUTE_SHADER || shader->shader_type == D3D10_SB_PIXEL_SHADER)) {
+    shader->dxil_lane_arg = shader->func_signature.DefineInput(air::InputThreadIndexInSimdgroup{});
+    shader->dxil_lanes_arg = shader->func_signature.DefineInput(air::InputThreadsPerSimdgroup{});
+  }
+  return 0;
+}
+
+/* --- Compile: dx.op calls to AIR --- */
+
+namespace {
+
+class Lowering {
+public:
+  Lowering(
+      llvm::IRBuilder<> &B, AIRBuilder &air, Converter &conv, BindingMap &binding, const ResourceTable &table,
+      const ShaderInfo &info
+  ) :
+      B(B),
