+    snprintf( name, sizeof(name), "/wmsync-%d", (int)getpid() );
+    shm_unlink( name );
+    if ((fd = shm_open( name, O_RDWR | O_CREAT | O_EXCL, 0600 )) < 0)
+    {
+        fprintf( stderr, "wineserver: msync: shm_open failed (%d), using server sync\n", errno );
+        return fd = -1;
+    }
+    shm_unlink( name );
+    fcntl( fd, F_SETFD, FD_CLOEXEC );
+    if (ftruncate( fd, MSYNC_SIZE ) < 0 ||
+        (shm = mmap( NULL, MSYNC_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 )) == MAP_FAILED)
+    {
+        fprintf( stderr, "wineserver: msync: cannot map shared memory (%d), using server sync\n", errno );
+        close( fd );
+        return fd = -1;
+    }
+    msync_init( shm );
+    msync_shm = shm;
+    return fd;
