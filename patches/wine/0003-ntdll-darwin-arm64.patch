+#ifdef __APPLE__
+/* neutron: next candidate after a collision with a host mapping Wine does not track
+ * (Metal and GPU memory, system libraries, FEX's JIT). Stepping by the alignment
+ * means one mach_vm_map per 64K under virtual_mutex, thousands of syscalls past
+ * Metal's reservations, and every thread waiting for the lock stalls meanwhile.
+ * Ask the kernel for the lowest mapping that ends above start and jump past it:
+ * bottom-up to its end, top-down below its start. */
+static void *skip_host_mapping( void *start, size_t size, ptrdiff_t step )
+{
+    mach_vm_address_t addr = (mach_vm_address_t)start;
+    mach_vm_size_t len;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    size_t align = step > 0 ? step : -step;
+    char *next = (char *)start + step;
+
+    if (mach_vm_region( mach_task_self(), &addr, &len, VM_REGION_BASIC_INFO_64,
+                        (vm_region_info_t)&info, &count, &object ) != KERN_SUCCESS)
+        return next;
+    if (object != MACH_PORT_NULL) mach_port_deallocate( mach_task_self(), object );
+    if (addr >= (mach_vm_address_t)start + size) return next;  /* not the colliding one */
+
+    if (step > 0)
+    {
+        char *after = (char *)(((addr + len) + align - 1) & ~(mach_vm_address_t)(align - 1));
+        return after > next ? after : next;
+    }
+    if (addr < size) return NULL;
+    {
+        char *below = (char *)((addr - size) & ~(mach_vm_address_t)(align - 1));
+        return below < next ? below : next;
+    }
+}
+#endif
