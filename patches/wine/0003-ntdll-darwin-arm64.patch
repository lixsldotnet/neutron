+/***********************************************************************
+ *           remap_view_jit
+ *
+ * neutron: Apple Silicon only allows write+exec on MAP_JIT memory, and MAP_JIT
+ * cannot be combined with MAP_FIXED. Recreate the view at the same address
+ * with MAP_JIT (a free spot is honoured as a hint). Used for EC code buffers
+ * that FEX allocates as RWX; FEX toggles pthread_jit_write_protect_np itself.
+ */
+static BOOL remap_view_jit( struct file_view *view )
+{
+    void *ptr;
+
+    munmap( view->base, view->size );
+    ptr = mmap( view->base, view->size, PROT_READ | PROT_WRITE | PROT_EXEC,
+                MAP_PRIVATE | MAP_ANON | MAP_JIT, -1, 0 );
+    if (ptr == view->base) return TRUE;
+    if (ptr != MAP_FAILED) munmap( ptr, view->size );
+    ERR( "MAP_JIT remap failed for %p-%p\n", view->base, (char *)view->base + view->size );
+    anon_mmap_fixed( view->base, view->size, PROT_NONE, 0 );
+    return FALSE;
+}
+#endif
 
 
