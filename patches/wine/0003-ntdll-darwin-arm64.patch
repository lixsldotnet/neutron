+#ifdef __APPLE__
+/* neutron: tool/neutron runs a game's Wine processes in a macOS sandbox
+ * (NEUTRON_SANDBOX=1). The wineserver opens files and sockets for its clients, so a
+ * sandboxed client must not use a server that runs outside a sandbox (started by a
+ * Wine call without the setting): it would open everything the sandbox denies. */
+int sandbox_check( pid_t pid, const char *operation, int type, ... );
 
+static void check_server_sandbox( int s )
+{
+    pid_t pid = 0;
+    socklen_t len = sizeof(pid);
 
+    if (sandbox_check( getpid(), NULL, 0 ) <= 0) return;  /* we are not sandboxed */
+    if (getsockopt( s, SOL_LOCAL, LOCAL_PEERPID, &pid, &len ) == -1 || pid <= 0)
+        fatal_perror( "wineserver pid" );
+    if (sandbox_check( pid, NULL, 0 ) <= 0)
+        fatal_error( "the wineserver for %s (pid %d) runs outside the sandbox; "
+                     "end it (wineserver -k) and start again\n", config_dir, (int)pid );
+}
+#endif
