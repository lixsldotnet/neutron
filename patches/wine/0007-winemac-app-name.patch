     - (void) updateFullscreenWindows
     {
+        /* neutron: a fullscreen game window that is not in macOS native fullscreen (notch
+         * displays) covers the whole screen at normal level; hide menu bar and Dock while the
+         * game is active, so the Cmd+Tab switcher still draws above it. */
+        if (getenv("NEUTRON_NATIVE_FULLSCREEN") && *getenv("NEUTRON_NATIVE_FULLSCREEN") == '1')
+        {
+            BOOL anyPlainFullscreen = FALSE;
+            NSApplicationPresentationOptions options;
+            for (NSNumber* number in [NSWindow windowNumbersWithOptions:0])
+            {
+                WineWindow* window = (WineWindow*)[NSApp windowWithWindowNumber:[number integerValue]];
+                if ([window isKindOfClass:[WineWindow class]] && window.fullscreen && !window.neutronNativeFullscreen &&
+                    [window isVisible])
+                {
+                    anyPlainFullscreen = TRUE;
+                    break;
+                }
+            }
+            options = anyPlainFullscreen ? (NSApplicationPresentationHideDock | NSApplicationPresentationHideMenuBar)
+                                         : NSApplicationPresentationDefault;
+            if ([NSApp isActive] && !([NSApp presentationOptions] & NSApplicationPresentationFullScreen) &&
+                [NSApp presentationOptions] != options)
+                [NSApp setPresentationOptions:options];
+        }
