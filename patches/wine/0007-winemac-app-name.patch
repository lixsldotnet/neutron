+    /* neutron: displays, their bounds and current modes as a string, to tell whether the
+     * display setup really changed */
+    static NSString* neutron_display_signature(void)
+    {
+        NSMutableString* sig = [NSMutableString string];
+        CGDirectDisplayID displays[32];
+        uint32_t i, count;
 
+        if (CGGetActiveDisplayList(32, displays, &count) != kCGErrorSuccess)
+            return nil;
+        for (i = 0; i < count; i++)
+        {
+            CGRect bounds = CGDisplayBounds(displays[i]);
+            CGDisplayModeRef mode = CGDisplayCopyDisplayMode(displays[i]);
+            [sig appendFormat:@"%u:%g,%g,%g,%g", displays[i], bounds.origin.x, bounds.origin.y,
+                              bounds.size.width, bounds.size.height];
+            if (mode)
+            {
+                [sig appendFormat:@":%zux%zu/%zux%zu@%g", CGDisplayModeGetWidth(mode), CGDisplayModeGetHeight(mode),
+                                  CGDisplayModeGetPixelWidth(mode), CGDisplayModeGetPixelHeight(mode),
+                                  CGDisplayModeGetRefreshRate(mode)];
+                CGDisplayModeRelease(mode);
+            }
+            [sig appendString:@";"];
+        }
+        return sig;
+    }
+
     - (void) sendDisplaysChanged:(BOOL)activating
     {
+        static NSString* lastSignature;
+        NSString* signature = neutron_display_signature();
+
+        /* neutron: the resync on activation rebuilds Wine's whole display list (registry,
+         * IOKit EDID reads, 100+ ms on the game thread). Games get re-activated on clicks,
+         * so only resync when the setup differs from what Wine last saw. */
+        if (activating && signature && [signature isEqualToString:lastSignature])
+            return;
+        [lastSignature release];
+        lastSignature = [signature retain];
+
         macdrv_event* event;
         WineEventQueue* queue;
 
