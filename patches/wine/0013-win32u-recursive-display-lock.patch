--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -164,7 +164,33 @@
 static INT64 last_query_display_time;
 static UINT64 monitor_update_serial;
 static pthread_mutex_t display_lock = PTHREAD_MUTEX_INITIALIZER;
+static DWORD display_lock_owner;
+static int display_lock_depth;
+
+/* neutron: the display lock is recursive for its owner thread. A driver mode change (winemac
+ * macdrv_set_display_mode) runs under the lock in apply_display_settings and handles queries
+ * (QUERY_MIN_MAX_INFO -> GetSystemMetrics -> lock_display_devices) on the same thread while it
+ * waits for the main thread, which deadlocked the game at startup. */
+static void display_mutex_lock(void)
+{
+    DWORD id = GetCurrentThreadId();
+    if (__atomic_load_n( &display_lock_owner, __ATOMIC_RELAXED ) == id)
+    {
+        display_lock_depth++;
+        return;
+    }
+    pthread_mutex_lock( &display_lock );
+    __atomic_store_n( &display_lock_owner, id, __ATOMIC_RELAXED );
+    display_lock_depth = 1;
+}
 
+static void display_mutex_unlock(void)
+{
+    if (--display_lock_depth) return;
+    __atomic_store_n( &display_lock_owner, 0, __ATOMIC_RELAXED );
+    pthread_mutex_unlock( &display_lock );
+}
+
