+#ifdef __APPLE__
+/* neutron: per-thread kqueue for precise sleeps, NEUTRON_PRECISE_TIMERS=0 disables */
+static int precise_timers_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0)
+    {
+        const char *e = getenv( "NEUTRON_PRECISE_TIMERS" );
+        enabled = !(e && e[0] == '0');
+    }
+    return enabled;
 }
 
+static __thread int precise_kq = -2;
+static int precise_timer_kq(void)
+{
+    if (precise_kq == -2)
+    {
+        precise_kq = kqueue();
+        if (precise_kq >= 0) fcntl( precise_kq, F_SETFD, FD_CLOEXEC );
+    }
+    return precise_kq;
+}
+#endif
 
