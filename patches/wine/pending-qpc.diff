 BOOL WINAPI DECLSPEC_HOTPATCH RtlQueryPerformanceCounter( LARGE_INTEGER *counter )
 {
+#if defined(WINE_TEB_IN_TSD) && (defined(__aarch64__) || defined(__arm64ec__))
+    /* neutron: read the counter in user mode (see darwin_continuous_time), the same
+     * value NtQueryPerformanceCounter computes on the unix side, without the syscall */
+    const volatile struct neutron_qpc_info *info = NEUTRON_QPC_INFO;
+    unsigned long long ticks;
+
+    if (info->enabled && darwin_continuous_time( &ticks ))
+    {
+        if (info->numer == 125 && info->denom == 3)  /* 24 MHz, constant divisions */
+            counter->QuadPart = ticks * 125 / 3 / 100;
+        else
+            counter->QuadPart = ticks * info->numer / info->denom / 100;
+        return TRUE;
+    }
+#endif
     NtQueryPerformanceCounter( counter, NULL );
     return TRUE;
 }
