 /******************************************************************************
+ *              init_qpc_info
+ *
+ * neutron: lets RtlQueryPerformanceCounter read the counter in PE code when the
+ * commpage has the user-mode path and gives the same values as mach_continuous_time.
+ */
+void init_qpc_info(void)
+{
+    volatile struct neutron_qpc_info *info = NEUTRON_QPC_INFO;
+    mach_timebase_info_data_t timebase;
+    const char *env = getenv( "NEUTRON_FAST_QPC" );
+    unsigned long long before, ticks, after;
+    int i;
+
+    if (env && !strcmp( env, "0" )) return;
+    if (mach_timebase_info( &timebase ) || !timebase.numer || !timebase.denom) return;
+    for (i = 0; i < 100; i++)
+    {
+        before = mach_continuous_time();
+        if (!darwin_continuous_time( &ticks )) return;
+        after = mach_continuous_time();
+        if (ticks < before || ticks > after)
+        {
+            WARN( "commpage time %llu outside %llu-%llu, using the syscall\n", ticks, before, after );
+            return;
+        }
+    }
+    info->numer = timebase.numer;
+    info->denom = timebase.denom;
+    info->enabled = 1;
+}
+#endif
+
