+#ifdef WINE_TEB_IN_TSD
+/* neutron: QueryPerformanceCounter without a syscall on arm64 macOS. Wine's QPC is
+ * mach_continuous_time() in 100 ns units. libsystem computes that in user mode from
+ * the commpage: the counter register named by _COMM_PAGE_USER_TIMEBASE plus
+ * _COMM_PAGE_CONT_HW_TIMEBASE, both read on every call, so the kernel's update after
+ * sleep is seen right away. PE code reads the same fields; the unix side checks them
+ * against mach_continuous_time() at process start and only then sets enabled (page
+ * after KUSER_SHARED_DATA, see virtual_alloc_first_thread_data). NEUTRON_FAST_QPC=0
+ * keeps the syscall. */
+struct neutron_qpc_info
+{
+    unsigned int enabled;
+    unsigned int numer;   /* mach_timebase_info */
+    unsigned int denom;
+};
+#define NEUTRON_QPC_INFO ((volatile struct neutron_qpc_info *)(WINE_USER_SHARED_DATA_VA + 0x10010))
+
+#if defined(__aarch64__) || defined(__arm64ec__)
+#define DARWIN_COMM_PAGE 0xfffffc000ull  /* _COMM_PAGE64_BASE_ADDRESS on arm64 */
+
+/* mach_continuous_time() as libsystem computes it, FALSE if the commpage has no user-mode path */
+static inline BOOL darwin_continuous_time( unsigned long long *ret )
+{
+    const volatile unsigned char *page = (const volatile unsigned char *)DARWIN_COMM_PAGE;
+    unsigned long long ticks;
+
+    if (!page[0x91]) return FALSE;  /* _COMM_PAGE_CONT_HWCLOCK */
+    switch (page[0x90])             /* _COMM_PAGE_USER_TIMEBASE */
+    {
+    case 3: __asm__ __volatile__( "mrs %0, s3_4_c15_c10_6" : "=r" (ticks) ); break;  /* ACNTVCT_EL0 */
+    case 2: __asm__ __volatile__( "mrs %0, s3_3_c14_c0_6" : "=r" (ticks) ); break;   /* CNTVCTSS_EL0 */
+    case 1: __asm__ __volatile__( "isb\n\tmrs %0, cntvct_el0" : "=r" (ticks) ); break;
+    default: return FALSE;
+    }
+    *ret = ticks + *(const volatile unsigned long long *)(DARWIN_COMM_PAGE + 0xa8);  /* _COMM_PAGE_CONT_HW_TIMEBASE */
+    return TRUE;
+}
+#endif
+#endif
+
