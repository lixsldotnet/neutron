+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#import "config.h"
+#import "macdrv.h"
+
+#import <GameController/GameController.h>
+
+#import "cocoa_app.h"
+#import "cocoa_event.h"
+#import "cocoa_window.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(rawmouse);
+
+#pragma GCC diagnostic ignored "-Wdeclaration-after-statement"
+
+
+/* Set while at least one GCMouse is connected. mouse.c then takes raw input
+ * only from MOUSE_MOVED_RAW events, not from cursor moves. */
+volatile bool neutron_raw_mouse = false;
+
+static double raw_remainder_x, raw_remainder_y;
+
+
+/* The window that gets the raw input: the key window, or after Cmd+Tab back into
+ * a fullscreen game, when macOS does not make a window key again, the frontmost
+ * visible Wine window. */
+static WineWindow* raw_mouse_window(void)
+{
+    NSWindow* window = [NSApp keyWindow];
+
+    if ([window isKindOfClass:[WineWindow class]]) return (WineWindow*)window;
+    for (window in [NSApp orderedWindows])
+    {
+        if ([window isKindOfClass:[WineWindow class]] && [window isVisible] && ![window isMiniaturized])
+            return (WineWindow*)window;
+    }
+    return nil;
+}
+
+static void raw_mouse_moved(float deltaX, float deltaY)
+{
+    WineWindow* window;
+    macdrv_event* event;
+    int x, y;
+
+    static unsigned int calls, inactive, nowindow;
+
+    if (!(++calls % 500))
+        TRACE("%u deltas, %u while inactive, %u without window, key %p\n", calls, inactive, nowindow, [NSApp keyWindow]);
+    if (![NSApp isActive]) { inactive++; return; }
+    if (!(window = raw_mouse_window())) { nowindow++; return; }
+
+    /* GameController counts y up, Windows raw input counts y down. Keep the
+       fractional part for the next event. */
+    raw_remainder_x += deltaX;
+    raw_remainder_y -= deltaY;
+    x = (int)raw_remainder_x;
+    y = (int)raw_remainder_y;
+    if (!x && !y) return;
+    raw_remainder_x -= x;
+    raw_remainder_y -= y;
+
+    event = macdrv_create_event(MOUSE_MOVED_RAW, window);
+    event->mouse_moved.x = x;
+    event->mouse_moved.y = y;
+    event->mouse_moved.drag = false;
+    event->mouse_moved.time_ms = [[WineApplicationController sharedController]
+                                  ticksForEventTime:[[NSProcessInfo processInfo] systemUptime]];
+    [window.queue postEvent:event];
+    macdrv_release_event(event);
+}
+
+static void attach_mouse(GCMouse* mouse)
+{
+    TRACE("raw mouse %s\n", [[mouse vendorName] UTF8String]);
+    mouse.mouseInput.mouseMovedHandler = ^(GCMouseInput* input, float deltaX, float deltaY) {
+        raw_mouse_moved(deltaX, deltaY);
+    };
+}
+
+static void update_raw_mouse(void)
+{
+    neutron_raw_mouse = [[GCMouse mice] count] > 0;
+    TRACE("%lu mice, raw mouse %s\n", (unsigned long)[[GCMouse mice] count],
+          neutron_raw_mouse ? "on" : "off");
+}
+
+/***********************************************************************
+ *              macdrv_start_raw_mouse
+ *
+ * Start listening for GCMouse devices. The handlers run on the main queue.
+ */
+void macdrv_start_raw_mouse(void)
+{
+    dispatch_async(dispatch_get_main_queue(), ^{
+        NSNotificationCenter* nc = [NSNotificationCenter defaultCenter];
+
+        [nc addObserverForName:GCMouseDidConnectNotification object:nil queue:nil
+                    usingBlock:^(NSNotification* note){
+            attach_mouse(note.object);
+            update_raw_mouse();
+        }];
+        [nc addObserverForName:GCMouseDidDisconnectNotification object:nil queue:nil
+                    usingBlock:^(NSNotification* note){
+            update_raw_mouse();
+        }];
+
+        for (GCMouse* mouse in [GCMouse mice])
+            attach_mouse(mouse);
+        update_raw_mouse();
+    });
+}
