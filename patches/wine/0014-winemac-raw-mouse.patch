--- a/dlls/winemac.drv/cocoa_rawmouse.m
+++ b/dlls/winemac.drv/cocoa_rawmouse.m
@@ -0,0 +1,134 @@
+/*
+ * MACDRV raw mouse input from GameController
+ *
+ * neutron: Windows games read mouse look from raw input (WM_INPUT), which on
+ * Windows carries unaccelerated device counts. NSEvent deltas have the macOS
+ * pointer acceleration in them and get the render scale applied, so they are
+ * only used for the cursor. GCMouse gives the device deltas without
+ * acceleration; they go to the key window as MOUSE_MOVED_RAW events.
+ *
