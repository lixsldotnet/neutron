+    /* neutron: a borderless top-level window covering a whole screen (a game in borderless
+     * fullscreen) goes into macOS native fullscreen, its own Space. Only there macOS scans
+     * the Metal layer out directly instead of compositing it, and turns on Game Mode. */
+    static BOOL neutron_native_fullscreen_enabled(void)
+    {
+        static int enabled = -1;
+        if (enabled < 0)
+        {
+            const char* env = getenv("NEUTRON_NATIVE_FULLSCREEN");
+            enabled = env && *env == '1';
+        }
+        return enabled;
+    }
+
+    /* neutron: on a display with a camera notch macOS puts native fullscreen windows below
+     * the notch and keeps the menu bar visible next to it; Windows still sees the whole
+     * screen and games fight over the window size (white screen in Unreal). There the game
+     * gets a plain window over the whole screen, the app hides menu bar and Dock instead. */
+    static BOOL neutron_screen_has_notch(NSScreen* screen)
+    {
+        if (@available(macOS 12.0, *))
+            return screen && screen.safeAreaInsets.top > 0;
+        return FALSE;
+    }
