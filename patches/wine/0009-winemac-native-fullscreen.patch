+    /* neutron: a borderless top-level window covering a whole screen (a game in borderless
+     * fullscreen) goes into macOS native fullscreen, its own Space. Only there macOS scans
+     * the Metal layer out directly instead of compositing it, and turns on Game Mode. */
+    static BOOL neutron_native_fullscreen_enabled(void)
+    {
+        static int enabled = -1;
+        if (enabled < 0)
+        {
+            const char* env = getenv("NEUTRON_NATIVE_FULLSCREEN");
+            enabled = env && *env == '1';
+        }
+        return enabled;
+    }
+
+    - (void) neutronUpdateNativeFullscreen
+    {
+        if (!neutron_native_fullscreen_enabled() || enteringFullScreen || exitingFullScreen)
+            return;
+        if (!neutronNativeFullscreen && fullscreen && [self isVisible] && !self.disabled &&
+            !([self styleMask] & NSWindowStyleMaskTitled) &&
+            !(self.parentWindow || self.latentParentWindow))
+        {
+            neutronNativeFullscreen = TRUE;
+            WARN("%p entering native fullscreen\n", self);
+            [self adjustFullScreenBehavior:[self collectionBehavior]];
+            [[WineApplicationController sharedController] adjustWindowLevels];
+            [self performSelector:@selector(neutronEnterNativeFullscreen) withObject:nil afterDelay:0];
+        }
+    }
+
+    - (void) neutronEnterNativeFullscreen
+    {
+        if (neutronNativeFullscreen && !([self styleMask] & NSWindowStyleMaskFullScreen) && [self isVisible])
+            [super toggleFullScreen:nil];
+    }
+
+    - (void) neutronLeaveNativeFullscreen:(NSRect)frame
+    {
+        neutronNativeFullscreen = FALSE;
+        nonFullscreenFrame = frame;
+        if ([self styleMask] & NSWindowStyleMaskFullScreen)
+            [super toggleFullScreen:nil];
+        [self adjustFullScreenBehavior:[self collectionBehavior]];
+        [[WineApplicationController sharedController] adjustWindowLevels];
+    }
+
