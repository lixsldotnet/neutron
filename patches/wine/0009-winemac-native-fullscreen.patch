+    - (void) neutronUpdateNativeFullscreen
+    {
+        if (!neutron_native_fullscreen_enabled() || enteringFullScreen || exitingFullScreen)
+            return;
+        if (!neutronNativeFullscreen && neutron_screen_has_notch([self screen]))
+            return;
+        if (!neutronNativeFullscreen && fullscreen && [self isVisible] && !self.disabled &&
+            !([self styleMask] & NSWindowStyleMaskTitled) &&
+            !(self.parentWindow || self.latentParentWindow))
