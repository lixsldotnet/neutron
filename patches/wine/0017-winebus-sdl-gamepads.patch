+/* neutron: NEUTRON_PAD_VIRTUAL=1 attaches an SDL virtual gamepad with Xbox 360 IDs
+ * (=<vid>:<pid> in hex for other IDs, e.g. 054c:0ce6 for the DualSense policy), so the
+ * whole path (SDL, winebus, XInput, DirectInput, raw HID, Windows.Gaming.Input,
+ * rumble, hotplug) can be tested without a real pad (tests/gamepad_list.c selftest).
+ * Every 400 ms it moves on: nothing, A, B + dpad up, left stick right/up + left
+ * trigger, nothing. Rumble comes back as input: right stick X = low frequency motor / 2,
+ * right trigger = high frequency motor / 2. Rumble 0xffff/0x0001 unplugs it for 1 s. */
+#if SDL_VERSION_ATLEAST(2, 24, 0)
+static int (*pSDL_JoystickAttachVirtualEx)(const SDL_VirtualJoystickDesc *desc);
+static int (*pSDL_JoystickDetachVirtual)(int device_index);
+static int (*pSDL_JoystickSetVirtualAxis)(SDL_Joystick *joystick, int axis, Sint16 value);
+static int (*pSDL_JoystickSetVirtualButton)(SDL_Joystick *joystick, int button, Uint8 value);
+static SDL_Joystick *(*pSDL_JoystickFromInstanceID)(SDL_JoystickID instance_id);
+static SDL_JoystickID (*pSDL_JoystickGetDeviceInstanceID)(int device_index);
+static int (*pSDL_NumJoysticks)(void);
+
+static BOOL virtual_pad;
+static unsigned int virtual_pad_vid = 0x045e, virtual_pad_pid = 0x028e;
+static SDL_JoystickID virtual_pad_id = -1;
+static Uint32 virtual_pad_start, virtual_pad_replug;
+static volatile Uint16 virtual_pad_low, virtual_pad_high;
+
+static void SDLCALL virtual_pad_update(void *userdata)
+{
+    SDL_Joystick *joystick = pSDL_JoystickFromInstanceID(virtual_pad_id);
+    unsigned int phase = (pSDL_GetTicks() - virtual_pad_start) / 400 % 5;
+
+    if (!joystick) return;
+    pSDL_JoystickSetVirtualButton(joystick, SDL_CONTROLLER_BUTTON_A, phase == 1);
+    pSDL_JoystickSetVirtualButton(joystick, SDL_CONTROLLER_BUTTON_B, phase == 2);
+    pSDL_JoystickSetVirtualButton(joystick, SDL_CONTROLLER_BUTTON_DPAD_UP, phase == 2);
+    pSDL_JoystickSetVirtualAxis(joystick, SDL_CONTROLLER_AXIS_LEFTX, phase == 3 ? 32767 : 0);
+    pSDL_JoystickSetVirtualAxis(joystick, SDL_CONTROLLER_AXIS_LEFTY, phase == 3 ? -32768 : 0);
+    pSDL_JoystickSetVirtualAxis(joystick, SDL_CONTROLLER_AXIS_TRIGGERLEFT, phase == 3 ? 32767 : -32768);
+    pSDL_JoystickSetVirtualAxis(joystick, SDL_CONTROLLER_AXIS_RIGHTX, virtual_pad_low / 2);
+    pSDL_JoystickSetVirtualAxis(joystick, SDL_CONTROLLER_AXIS_TRIGGERRIGHT, (int)virtual_pad_high - 32768);
+}
+
+static int SDLCALL virtual_pad_rumble(void *userdata, Uint16 low, Uint16 high)
+{
+    TRACE("virtual pad rumble %#x %#x\n", low, high);
+    if (low == 0xffff && high == 0x0001) virtual_pad_replug = pSDL_GetTicks();
+    else virtual_pad_low = low, virtual_pad_high = high;
+    /* sdl2-compat 2.32.74 hands this SDL2 int (0 = success) to SDL3 as a bool, so
+     * success has to be non-zero there, or SDL3 never sends the stop */
+    return 1;
+}
+
+static void virtual_pad_attach(void)
+{
+    static SDL_VirtualJoystickDesc desc =
+    {
+        .version = SDL_VIRTUAL_JOYSTICK_DESC_VERSION,
+        .type = SDL_JOYSTICK_TYPE_GAMECONTROLLER,
+        .naxes = SDL_CONTROLLER_AXIS_MAX,
+        .nbuttons = SDL_CONTROLLER_BUTTON_DPAD_RIGHT + 1,
+        .button_mask = (1 << (SDL_CONTROLLER_BUTTON_DPAD_RIGHT + 1)) - 1,
+        .axis_mask = (1 << SDL_CONTROLLER_AXIS_MAX) - 1,
+        .name = "neutron virtual pad",
+        .Update = virtual_pad_update,
+        .Rumble = virtual_pad_rumble,
+    };
+    int index;
+
+    desc.vendor_id = virtual_pad_vid;
+    desc.product_id = virtual_pad_pid;
+    index = pSDL_JoystickAttachVirtualEx(&desc);
+
+    virtual_pad_low = virtual_pad_high = 0;
+    virtual_pad_start = pSDL_GetTicks();
+    virtual_pad_id = index < 0 ? -1 : pSDL_JoystickGetDeviceInstanceID(index);
+    if (index < 0) ERR("could not attach the virtual pad: %s\n", pSDL_GetError());
+    else TRACE("virtual pad attached, index %d id %d\n", index, virtual_pad_id);
 }
 
+static void virtual_pad_init(void)
+{
+    const char *env = getenv("NEUTRON_PAD_VIRTUAL");
+
+    if (!env || (strcmp(env, "1") && sscanf(env, "%x:%x", &virtual_pad_vid, &virtual_pad_pid) != 2)) return;
+#define LOAD_FUNCPTR(f) if (!(p##f = dlsym(sdl_handle, #f))) { ERR("no %s for the virtual pad\n", #f); return; }
+    LOAD_FUNCPTR(SDL_JoystickAttachVirtualEx);
+    LOAD_FUNCPTR(SDL_JoystickDetachVirtual);
+    LOAD_FUNCPTR(SDL_JoystickSetVirtualAxis);
+    LOAD_FUNCPTR(SDL_JoystickSetVirtualButton);
+    LOAD_FUNCPTR(SDL_JoystickFromInstanceID);
+    LOAD_FUNCPTR(SDL_JoystickGetDeviceInstanceID);
+    LOAD_FUNCPTR(SDL_NumJoysticks);
+#undef LOAD_FUNCPTR
+    virtual_pad = TRUE;
+    virtual_pad_attach();
+}
+
+/* Runs in the bus thread: unplugs the pad when asked and plugs it in again after 1 s. */
+static void virtual_pad_poll(void)
+{
+    int i;
+
+    if (!virtual_pad || !virtual_pad_replug) return;
+    if (virtual_pad_id != -1)
+    {
+        for (i = 0; i < pSDL_NumJoysticks(); i++)
+            if (pSDL_JoystickGetDeviceInstanceID(i) == virtual_pad_id) pSDL_JoystickDetachVirtual(i);
+        TRACE("virtual pad detached\n");
+        virtual_pad_id = -1;
+    }
+    else if (pSDL_GetTicks() - virtual_pad_replug >= 1000)
+    {
+        virtual_pad_replug = 0;
+        virtual_pad_attach();
+    }
+}
+#else
+static void virtual_pad_init(void) {}
+static void virtual_pad_poll(void) {}
+#endif
