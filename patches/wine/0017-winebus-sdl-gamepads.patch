+/* neutron: Proton leaves PlayStation and Nintendo pads as raw HID devices and relies
+ * on Steam Input for XInput; the Mac Steam client has no Steam Input for Windows
+ * games. So they go through SDL as XInput gamepads like every other pad, unless
+ * NEUTRON_PAD_HIDRAW=1 (raw HID for games with their own PlayStation or Switch
+ * support: light bar, touchpad, gyro, adaptive triggers, button glyphs). services.exe
+ * gives winedevice a fresh Windows environment, so the SDL bus reads the variable
+ * from the Unix environment into options.pad_hidraw. */
+static BOOL is_console_pad(WORD vid, WORD pid)
+{
+    if (is_dualshock4_gamepad(vid, pid) || is_dualsense_gamepad(vid, pid)) return TRUE;
+    return vid == 0x057e && (pid == 0x2006 || pid == 0x2007 || pid == 0x2008 || pid == 0x2009 || pid == 0x057e);
+}
