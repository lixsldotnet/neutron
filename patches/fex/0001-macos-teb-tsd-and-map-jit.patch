index 0000000..b1d2287
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/JITWriteScope.h
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <FEXCore/Utils/CompilerDefs.h>
+
+namespace FEXCore::Utils {
+// neutron: on Apple Silicon, MAP_JIT memory is either writable or executable per thread.
+// The frontend installs a toggle that switches the current thread to write mode (true)
+// and back to exec mode (false); the toggle handles nesting itself.
+using JITWriteToggleFn = void (*)(bool Write);
+FEX_DEFAULT_VISIBILITY extern JITWriteToggleFn JITWriteToggle;
+
+class JITWriteScope final {
+public:
+  JITWriteScope() {
+    if (JITWriteToggle) {
+      JITWriteToggle(true);
+    }
+  }
+  ~JITWriteScope() {
+    if (JITWriteToggle) {
+      JITWriteToggle(false);
+    }
+  }
+  JITWriteScope(const JITWriteScope&) = delete;
+  JITWriteScope& operator=(const JITWriteScope&) = delete;
+};
+} // namespace FEXCore::Utils
