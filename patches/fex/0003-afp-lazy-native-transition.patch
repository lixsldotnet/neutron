+bool Arm64JITCore::BlockUsesFPR(IR::Ref BlockNode) const {
+  const auto IsFPRClass = [](IR::RegClass C) { return C == IR::RegClass::FPR || C == IR::RegClass::FPRFixed; };
+  for (auto [CodeNode, IROp] : IR->GetCode(BlockNode)) {
+    if (IR::GetHasDest(IROp->Op) && IsFPRClass(IR::PhysicalRegister(CodeNode).AsRegClass())) {
+      return true;
+    }
+    const int NumRAArgs = IR::GetRAArgs(IROp->Op);
+    for (int i = 0; i < NumRAArgs; ++i) {
+      if (IROp->Args[i].IsImmediate() && IsFPRClass(IR::PhysicalRegister(IROp->Args[i]).AsRegClass())) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
